@{ Layout = "_EmailLayout.cshtml"; }
<h2 style="margin: 0 0 16px 0; font-size: 20px; color: #333;">Invitación a proyecto</h2>
<p style="margin: 0 0 16px 0; font-size: 15px; line-height: 1.6; color: #555;">
    Hola <strong>@Model.FirstName @Model.LastName</strong>,
</p>
<p style="margin: 0 0 16px 0; font-size: 15px; line-height: 1.6; color: #555;">
    Has sido invitado/a a participar en el proyecto <strong>@Model.ProjectName</strong>
    de la incubadora <strong>@Model.IncubatorName</strong> en la plataforma Mentoory.
</p>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin: 16px 0; background-color: #f8f9fc; border-radius: 6px; border: 1px solid #e3e6f0;">
    <tr>
        <td style="padding: 16px;">
            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                <tr>
                    <td style="padding: 4px 0; font-size: 14px; color: #858796; width: 140px;">Proyecto:</td>
                    <td style="padding: 4px 0; font-size: 14px; color: #333; font-weight: 600;">@Model.ProjectName</td>
                </tr>
                <tr>
                    <td style="padding: 4px 0; font-size: 14px; color: #858796;">Incubadora:</td>
                    <td style="padding: 4px 0; font-size: 14px; color: #333; font-weight: 600;">@Model.IncubatorName</td>
                </tr>
            </table>
        </td>
    </tr>
</table>
<p style="margin: 0 0 16px 0; font-size: 15px; line-height: 1.6; color: #555;">
    Para aceptar la invitación, haz clic en el siguiente enlace:
</p>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin: 24px 0;">
    <tr>
        <td align="center">
            <a href="@Model.ActionUrl"
               style="display: inline-block; padding: 12px 32px; background-color: #4e73df; color: #ffffff; text-decoration: none; border-radius: 6px; font-size: 15px; font-weight: 600;">
                Aceptar invitación
            </a>
        </td>
    </tr>
</table>
<p style="margin: 0 0 8px 0; font-size: 13px; color: #858796;">
    Si no puedes hacer clic en el botón, copia y pega el siguiente enlace en tu navegador:
</p>
<p style="margin: 0 0 16px 0; font-size: 13px; color: #4e73df; word-break: break-all;">
    @Model.ActionUrl
</p>
<div style="background-color: #f8f9fc; border-radius: 6px; padding: 12px 16px; border: 1px solid #e3e6f0;">
    <p style="margin: 0; font-size: 13px; color: #858796;">
        <strong>Importante:</strong> Esta invitación expirará en <strong>@Model.ExpirationHours horas</strong>.
        Si la invitación ha expirado, solicita una nueva al coordinador de tu proyecto.
    </p>
</div>
