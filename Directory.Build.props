<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PlatformTarget>AnyCPU</PlatformTarget>
    </PropertyGroup>
    <PropertyGroup>
        <NoWarn>1591;CS8618;SA1649;SA1210;SA1413;SA1515;SA1516;SA1116;SA1117;SA1118;SA1518;SA1505;SA1137</NoWarn> <!-- Remove this to turn on warnings for missing XML Comments -->
    </PropertyGroup>
    <PropertyGroup>
        <CodeAnalysisRuleSet>..\Analyzers.ruleset</CodeAnalysisRuleSet>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="StyleCop.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- Pin OpenTelemetry.Api floor across all projects so transitive resolutions cannot fall back to vulnerable 1.15.0 / 1.15.2 (GHSA-g94r-2vxg-569j). -->
        <PackageReference Include="OpenTelemetry.Api" />
    </ItemGroup>
    
</Project>