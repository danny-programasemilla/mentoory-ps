<Project Sdk="Microsoft.Build.Sql/2.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlAzureV12DatabaseSchemaProvider</DSP>
    <OutputType>Database</OutputType>
    <IncludeCompositeObjects>true</IncludeCompositeObjects>
    <ProjectGuid>{00000000-0000-0000-0000-000000000000}</ProjectGuid>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="**/*.sql" Exclude="bin/**;obj/**;../Mentoory.Db.PostDeployment/**;MentooryDb_*.sql" />
  </ItemGroup>
  <ItemGroup>
    <PostDeploy Include="../Mentoory.Db.PostDeployment/Script.PostDeployment.sql" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\Mentoory.Db.PostDeployment\000.SeedExample.sql">
      <Link>PostDeploymentReferences\000.SeedExample.sql</Link>
    </None>
      <None Include="..\Mentoory.Db.PostDeployment\001.SeedRoles.sql">
          <Link>PostDeploymentReferences\001.SeedRoles.sql</Link>
      </None>
      <None Include="..\Mentoory.Db.PostDeployment\002.SeedGlobalAdmin.sql">
          <Link>PostDeploymentReferences\002.SeedGlobalAdmin.sql</Link>
      </None>
      <None Include="..\Mentoory.Db.PostDeployment\003.SeedDefaultSubscriptionPlan.sql">
          <Link>PostDeploymentReferences\003.SeedDefaultSubscriptionPlan.sql</Link>
      </None>
      <None Include="..\Mentoory.Db.PostDeployment\004.SeedTestData.sql">
          <Link>PostDeploymentReferences\004.SeedTestData.sql</Link>
      </None>
      <None Include="..\Mentoory.Db.PostDeployment\016.SeedCountries.sql">
          <Link>PostDeploymentReferences\016.SeedCountries.sql</Link>
      </None>
      <None Include="..\Mentoory.Db.PostDeployment\017.SeedSystemConfiguration.sql">
          <Link>PostDeploymentReferences\017.SeedSystemConfiguration.sql</Link>
      </None>
      <None Include="..\Mentoory.Db.PostDeployment\018.SeedProjectPublicFlag.sql">
          <Link>PostDeploymentReferences\018.SeedProjectPublicFlag.sql</Link>
      </None>
      <None Include="..\Mentoory.Db.PostDeployment\019.SeedTenantSystemConfiguration.sql">
          <Link>PostDeploymentReferences\019.SeedTenantSystemConfiguration.sql</Link>
      </None>
  </ItemGroup>
</Project>