# Copy to .env on the VM and fill in. NEVER commit the real .env.
#   cp .env.example .env && nano .env
#
# deploy.sh never overwrites this file once it exists on the VM.

# --- Reverse proxy / TLS ---
# Domain Caddy serves (and the app's external host). An A record for this name
# MUST resolve to the VM's public IP before the first deploy, or Caddy cannot
# issue the Let's Encrypt certificate.
APP_DOMAIN=mentoory-dev.example.com

# Let's Encrypt registration/recovery email.
ACME_EMAIL=you@example.com

# --- Database ---
# SQL Server SA password. Must satisfy SQL complexity (>=8 chars, upper+lower+digit+symbol).
# Used by the mssql container AND by the webapp's DefaultConnection (set in docker-compose.yml)
# AND by deploy.sh --schema / publish-dacpac-vm.sh (must match).
MSSQL_SA_PASSWORD=ChangeMe_Strong1!

# --- Application ---
# MediatR 14 license key (recommended for production; empty runs with a community notice).
MEDIATR_LICENSE_KEY=

# --- Attachments storage (FUTURE USE — no Mentoory code consumes this yet) ---
# Leave unset/empty. provision-storage.sh can create a Blob account + grant the VM
# managed identity; set these only once an attachments feature is added.
#   STORAGE_PROVIDER=AzureBlob
#   BLOB_CONNECTION=https://<account>.blob.core.windows.net
STORAGE_PROVIDER=
BLOB_CONNECTION=

# --- Telemetry (optional) ---
# Empty = no OTLP export (default, zero overhead). To view logs/traces/metrics in the
# on-demand Aspire dashboard, set this and start the dashboard:
#   docker compose --profile debug up -d aspire-dashboard
# OTEL_ENDPOINT=http://aspire-dashboard:18889
OTEL_ENDPOINT=
