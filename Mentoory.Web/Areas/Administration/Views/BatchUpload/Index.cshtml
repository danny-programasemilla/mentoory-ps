@model Mentoory.Web.Areas.Administration.Models.BatchUploadViewModel
@{
    ViewData["Title"] = "Carga Masiva de Usuarios";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <form asp-action="Index" method="post" enctype="multipart/form-data">
            <div class="card">
                <div class="card-body">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="hr-text">Proyecto</div>

                    <div class="mb-3">
                        <label asp-for="ProjectExternalId" class="form-label"></label>
                        @if (Model.Projects.Count > 0)
                        {
                            <select asp-for="ProjectExternalId" class="form-select">
                                <option value="">Seleccione un proyecto</option>
                                @foreach (var project in Model.Projects)
                                {
                                    <option value="@project.ExternalId">@project.Name</option>
                                }
                            </select>
                        }
                        else
                        {
                            <div class="alert alert-warning mb-0">
                                No hay proyectos en etapa de registro. Cree un proyecto primero.
                            </div>
                        }
                        <span asp-validation-for="ProjectExternalId" class="text-danger"></span>
                    </div>

                    <div class="hr-text">Archivo</div>

                    <div class="mb-3">
                        <label asp-for="CsvFile" class="form-label"></label>
                        <input asp-for="CsvFile" class="form-control" accept=".csv" />
                        <span class="form-hint">
                            Formato CSV con columnas: Country, Identification, Email, FirstName, LastName. Máximo 500 filas.
                            <a asp-action="DownloadSample" class="ms-1">Descargar plantilla CSV</a>
                        </span>
                        <span asp-validation-for="CsvFile" class="text-danger"></span>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="btn-list justify-content-end">
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-upload me-1"></i>Procesar Archivo
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/batch-upload.js"></script>
}
