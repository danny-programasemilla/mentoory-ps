@model Mentoory.Web.Areas.Administration.Models.BatchUploadViewModel
@{
    ViewData["Title"] = "Carga Masiva de Usuarios";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-8">
            @if (!Model.HasActiveProject)
            {
                <div class="alert alert-warning d-flex align-items-center" role="alert">
                    <i class="ti ti-alert-triangle me-2"></i>
                    <div>Seleccione un proyecto desde el selector de contexto para continuar.</div>
                </div>
            }

            @if (TempData["ErrorMessage"] is string errorMsg)
            {
                <div class="alert alert-danger" role="alert">@errorMsg</div>
            }

            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Carga Masiva de Usuarios</h5>
                    @if (Model.HasActiveProject && !string.IsNullOrEmpty(Model.ActiveProjectName))
                    {
                        <p class="text-muted mb-0 mt-1">
                            <i class="ti ti-folder me-1"></i>Proyecto: <strong>@Model.ActiveProjectName</strong>
                        </p>
                    }
                </div>
                <div class="card-body">
                    <form asp-action="Index" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <fieldset @(Model.HasActiveProject ? "" : "disabled")>
                            <div class="mb-3">
                                <label asp-for="CsvFile" class="form-label"></label>
                                <input asp-for="CsvFile" class="form-control" accept=".csv" />
                                <div class="form-text">
                                    Formato CSV con columnas: Country, Identification, Email, FirstName, LastName. Máximo 500 filas.
                                    <a asp-action="DownloadSample" class="ms-1">Descargar plantilla CSV</a>
                                </div>
                                <span asp-validation-for="CsvFile" class="text-danger"></span>
                            </div>

                            <hr class="my-4">
                            <h6 class="mb-3">Opciones de incorporación (aplica a todas las filas)</h6>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <div class="form-check form-switch">
                                        <input asp-for="SkipEmailVerification" class="form-check-input" />
                                        <label asp-for="SkipEmailVerification" class="form-check-label"></label>
                                    </div>
                                    <small class="text-muted">Los usuarios no necesitarán verificar su correo electrónico.</small>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check form-switch">
                                        <input asp-for="SkipInvitationAcceptance" class="form-check-input" />
                                        <label asp-for="SkipInvitationAcceptance" class="form-check-label"></label>
                                    </div>
                                    <small class="text-muted">Los usuarios serán inscritos directamente sin aceptar invitación.</small>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary">Procesar Archivo</button>
                            </div>
                        </fieldset>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
