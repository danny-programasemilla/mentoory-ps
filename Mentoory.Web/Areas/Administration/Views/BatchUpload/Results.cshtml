@model Mentoory.Access.Application.Commands.BatchRegisterUsers.BatchRegistrationResult
@{
    ViewData["Title"] = "Resultados de Carga Masiva";
}

<div class="container-fluid">
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="card-title mb-0">Resultados de Carga Masiva</h5>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-3">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h6>Total</h6>
                            <h3>@Model.TotalRows</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-success text-white">
                        <div class="card-body text-center">
                            <h6>Exitosos</h6>
                            <h3>@Model.SuccessCount</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-warning">
                        <div class="card-body text-center">
                            <h6>Omitidos</h6>
                            <h3>@Model.SkippedCount</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-danger text-white">
                        <div class="card-body text-center">
                            <h6>Errores</h6>
                            <h3>@Model.ErrorCount</h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-sm">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>País</th>
                            <th>Identificación</th>
                            <th>Correo</th>
                            <th>Estado</th>
                            <th>Contraseña temporal</th>
                            <th>Observaciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            var rowClass = row.Status switch
                            {
                                "Success" => "table-success",
                                "Skipped" => "table-warning",
                                "Error" => "table-danger",
                                _ => string.Empty
                            };
                            <tr class="@rowClass">
                                <td>@row.RowNumber</td>
                                <td>@row.Country</td>
                                <td>@row.Identification</td>
                                <td>@row.Email</td>
                                <td>@row.Status</td>
                                <td>@(row.TemporaryPassword ?? "—")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(row.ErrorMessage))
                                    {
                                        <span class="text-danger">@row.ErrorMessage</span>
                                    }
                                    @foreach (var warning in row.Warnings)
                                    {
                                        <span class="text-warning d-block">@warning</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <a asp-action="Index" class="btn btn-primary mt-3">Nueva Carga</a>
        </div>
    </div>
</div>
