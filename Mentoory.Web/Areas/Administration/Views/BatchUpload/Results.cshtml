@model Mentoory.Access.Application.Commands.BatchRegisterUsers.BatchRegistrationResult
@{
    ViewData["Title"] = "Resultados de Carga Masiva";
}

<div class="row row-deck row-cards mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="subheader">Total</div>
                </div>
                <div class="h1 mb-0">@Model.TotalRows</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="subheader text-success">Exitosos</div>
                </div>
                <div class="h1 mb-0 text-success">@Model.SuccessCount</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="subheader text-warning">Omitidos</div>
                </div>
                <div class="h1 mb-0 text-warning">@Model.SkippedCount</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="subheader text-danger">Errores</div>
                </div>
                <div class="h1 mb-0 text-danger">@Model.ErrorCount</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Detalle de Resultados</h3>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>País</th>
                    <th>Identificación</th>
                    <th>Correo</th>
                    <th>Estado</th>
                    <th>Contraseña temporal</th>
                    <th>Observaciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    var statusClass = row.Status switch
                    {
                        "Success" => "status-success",
                        "Skipped" => "status-warning",
                        "Error" => "status-danger",
                        _ => string.Empty
                    };
                    var statusText = row.Status switch
                    {
                        "Success" => "Exitoso",
                        "Skipped" => "Omitido",
                        "Error" => "Error",
                        _ => row.Status
                    };
                    <tr>
                        <td>@row.RowNumber</td>
                        <td>@row.Country</td>
                        <td>@row.Identification</td>
                        <td>@row.Email</td>
                        <td><span class="status @statusClass"><span class="status-dot"></span> @statusText</span></td>
                        <td>@(row.TemporaryPassword ?? "—")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(row.ErrorMessage))
                            {
                                <span class="text-danger">@row.ErrorMessage</span>
                            }
                            @foreach (var warning in row.Warnings)
                            {
                                <span class="text-warning d-block">@warning</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer">
        <div class="btn-list">
            <a asp-action="Index" class="btn btn-primary">
                <i class="ti ti-upload me-1"></i>Nueva Carga
            </a>
        </div>
    </div>
</div>
