@using Mentoory.Access.Application.Commands.CreateUser
@model Mentoory.Access.Application.Commands.BatchCreateUsers.BatchCreateUsersResult
@{
    ViewData["Title"] = "Resultados de Carga Masiva";
}

<div class="container-fluid">
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="card-title mb-0">Resultados de Carga Masiva</h5>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-3">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h6>Total</h6>
                            <h3>@Model.TotalCount</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-success text-white">
                        <div class="card-body text-center">
                            <h6>Creados</h6>
                            <h3>@Model.CreatedCount</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-info text-white">
                        <div class="card-body text-center">
                            <h6>Inscritos</h6>
                            <h3>@Model.EnrolledCount</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-danger text-white">
                        <div class="card-body text-center">
                            <h6>Errores</h6>
                            <h3>@Model.ErrorCount</h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-sm">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Pais</th>
                            <th>Identificacion</th>
                            <th>Correo</th>
                            <th>Estado</th>
                            <th>Contrasena temporal</th>
                            <th>Observaciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            var rowClass = row.Outcome switch
                            {
                                CreateUserOutcome.Created => "table-success",
                                CreateUserOutcome.Enrolled => "table-info",
                                CreateUserOutcome.AlreadyEnrolled => "table-warning",
                                _ => row.Errors.Count > 0 ? "table-danger" : string.Empty
                            };
                            var statusLabel = row.Outcome switch
                            {
                                CreateUserOutcome.Created => "Creado",
                                CreateUserOutcome.Enrolled => "Inscrito",
                                CreateUserOutcome.AlreadyEnrolled => "Ya inscrito",
                                _ => "Error"
                            };
                            <tr class="@rowClass">
                                <td>@row.RowNumber</td>
                                <td>@row.Country</td>
                                <td>@row.Identification</td>
                                <td>@row.Email</td>
                                <td>@statusLabel</td>
                                <td>@(row.TemporaryPassword ?? "—")</td>
                                <td>
                                    @foreach (var error in row.Errors)
                                    {
                                        <span class="text-danger d-block">@error</span>
                                    }
                                    @foreach (var warning in row.Warnings)
                                    {
                                        <span class="text-warning d-block">@warning</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <a asp-action="Index" class="btn btn-primary mt-3">Nueva Carga</a>
        </div>
    </div>
</div>
