@model Mentoory.Web.Areas.Administration.Models.CreateUserViewModel
@{
    ViewData["Title"] = "Crear Usuario";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-8">
            @if (!Model.HasActiveProject)
            {
                <div class="alert alert-warning d-flex align-items-center" role="alert">
                    <i class="ti ti-alert-triangle me-2"></i>
                    <div>Seleccione un proyecto desde el selector de contexto para continuar.</div>
                </div>
            }

            @if (TempData["SuccessMessage"] is string successMsg)
            {
                <div class="alert alert-success d-flex align-items-center" role="alert">
                    <i class="ti ti-check me-2"></i>
                    <div>@successMsg</div>
                </div>
            }

            @if (TempData["TemporaryPassword"] is string tempPassword)
            {
                <div class="alert alert-info" role="alert">
                    <h6 class="alert-heading">Contrasena temporal</h6>
                    <p class="mb-0">
                        <code class="fs-5 user-select-all">@tempPassword</code>
                    </p>
                    <hr>
                    <p class="mb-0 small text-muted">Copie esta contrasena y entreguela al usuario. No se mostrara de nuevo.</p>
                </div>
            }

            @if (TempData["WarningMessage"] is string warningMsg)
            {
                <div class="alert alert-warning" role="alert">@warningMsg</div>
            }

            @if (TempData["ErrorMessage"] is string errorMsg)
            {
                <div class="alert alert-danger" role="alert">@errorMsg</div>
            }

            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Crear Usuario</h5>
                    @if (Model.HasActiveProject && !string.IsNullOrEmpty(Model.ActiveProjectName))
                    {
                        <p class="text-muted mb-0 mt-1">
                            <i class="ti ti-folder me-1"></i>Proyecto: <strong>@Model.ActiveProjectName</strong>
                        </p>
                    }
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <fieldset @(Model.HasActiveProject ? "" : "disabled")>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="Email" class="form-label"></label>
                                    <input asp-for="Email" class="form-control" type="email" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="Country" class="form-label"></label>
                                    <select asp-for="Country" class="form-select" id="countrySelect">
                                        <option value="">Seleccione un pais</option>
                                        @foreach (var country in Model.Countries)
                                        {
                                            <option value="@country.Code"
                                                    data-mask="@country.IdentificationMask"
                                                    data-maxlength="@country.IdentificationMaxLength"
                                                    data-label="@country.IdentificationLabel">
                                                @country.Name
                                            </option>
                                        }
                                    </select>
                                    <span asp-validation-for="Country" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Identification" class="form-label" id="identificationLabel"></label>
                                    <input asp-for="Identification" class="form-control" id="identificationInput" />
                                    <span asp-validation-for="Identification" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="FirstName" class="form-label"></label>
                                    <input asp-for="FirstName" class="form-control" />
                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="LastName" class="form-label"></label>
                                    <input asp-for="LastName" class="form-control" />
                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                </div>
                            </div>

                            <hr class="my-4">
                            <h6 class="mb-3">Opciones de incorporacion</h6>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <div class="form-check form-switch">
                                        <input asp-for="SkipEmailVerification" class="form-check-input" id="skipEmailVerification" />
                                        <label asp-for="SkipEmailVerification" class="form-check-label"></label>
                                    </div>
                                    <small class="text-muted">El usuario no necesitara verificar su correo electronico.</small>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check form-switch">
                                        <input asp-for="SkipInvitationAcceptance" class="form-check-input" id="skipInvitationAcceptance" />
                                        <label asp-for="SkipInvitationAcceptance" class="form-check-label"></label>
                                    </div>
                                    <small class="text-muted">El usuario sera inscrito directamente sin aceptar invitacion.</small>
                                </div>
                            </div>

                            <div id="toggleInfo" class="alert alert-info d-none mb-3">
                                <small id="toggleInfoText"></small>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary">Crear Usuario</button>
                                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                            </div>
                        </fieldset>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/user-creation.js"></script>
}
