@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Usuarios</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-user-plus me-1"></i>Crear Usuario
    </a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (TempData["WarningMessage"] is string warningMsg)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @warningMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (TempData["TemporaryPassword"] is string tempPassword)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <h6 class="alert-heading">Contrasena temporal</h6>
        <p class="mb-0"><code class="fs-5 user-select-all">@tempPassword</code></p>
        <hr>
        <p class="mb-0 small text-muted">Copie esta contrasena y entreguela al usuario. No se mostrara de nuevo.</p>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table id="usersTable" class="table table-striped table-hover w-100">
                <thead>
                    <tr>
                        <th>Correo Electronico</th>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Estado</th>
                        <th>Incorporacion</th>
                        <th>Fecha de Registro</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script src="~/js/datatable-helper.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            initDataTable('usersTable', {
                apiUrl: '@Url.Action("Data", "Users", new { area = "Administration" })',
                columns: [
                    { data: 'email' },
                    { data: 'firstName' },
                    { data: 'lastName' },
                    {
                        data: 'accountStatus',
                        render: function (data) {
                            var badgeClass = 'bg-secondary';
                            if (data === 'Active') badgeClass = 'bg-success';
                            else if (data === 'Locked') badgeClass = 'bg-danger';
                            else if (data === 'PendingVerification') badgeClass = 'bg-warning text-dark';
                            else if (data === 'PasswordResetRequired') badgeClass = 'bg-info';
                            return '<span class="badge ' + badgeClass + '">' + data + '</span>';
                        }
                    },
                    {
                        data: 'onboardingStatus',
                        render: function (data) {
                            if (!data) return '<span class="badge bg-secondary">—</span>';
                            var badgeClass = 'bg-secondary';
                            if (data === 'Activo') badgeClass = 'bg-success';
                            else if (data.indexOf('Pendiente') === 0) badgeClass = 'bg-warning text-dark';
                            return '<span class="badge ' + badgeClass + '">' + data + '</span>';
                        }
                    },
                    {
                        data: 'createdAtUtc',
                        render: function (data) {
                            return new Date(data).toLocaleDateString('es');
                        }
                    }
                ],
                defaultOrder: [[5, 'desc']]
            });
        });
    </script>
}
