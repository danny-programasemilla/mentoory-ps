@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Usuarios</h2>
    <a asp-action="Enroll" class="btn btn-primary">
        <i class="ti ti-user-plus me-1"></i>Inscribir Usuario
    </a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@await Component.InvokeAsync("DataTable", new { tableId = "usersTable", columns = new[] { "Correo Electrónico", "Nombre", "Apellido", "Estado", "Fecha de Registro" } })

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script src="~/js/datatable-helper.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            initDataTable('usersTable', {
                apiUrl: '@Url.Action("Data", "Users", new { area = "Administration" })',
                columns: [
                    { data: 'email' },
                    { data: 'firstName' },
                    { data: 'lastName' },
                    {
                        data: 'accountStatus',
                        render: function (data) { return renderAccountStatus(data); }
                    },
                    {
                        data: 'createdAtUtc',
                        render: function (data) { return formatDate(data); }
                    }
                ],
                defaultOrder: [[4, 'desc']]
            });
        });
    </script>
}
