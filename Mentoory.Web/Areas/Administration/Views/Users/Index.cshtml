@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Usuarios</h2>
    <a asp-action="Enroll" class="btn btn-primary">
        <i class="ti ti-user-plus me-1"></i>Inscribir Usuario
    </a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="card">
    <div class="table-responsive">
        <table id="usersTable" class="table table-vcenter card-table w-100">
            <thead>
                <tr>
                    <th>Correo Electrónico</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Estado</th>
                    <th>Fecha de Registro</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script src="~/js/datatable-helper.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            initDataTable('usersTable', {
                apiUrl: '@Url.Action("Data", "Users", new { area = "Administration" })',
                columns: [
                    { data: 'email' },
                    { data: 'firstName' },
                    { data: 'lastName' },
                    {
                        data: 'accountStatus',
                        render: function (data) {
                            var badgeClass = 'bg-secondary';
                            if (data === 'Active') badgeClass = 'bg-success';
                            else if (data === 'Locked') badgeClass = 'bg-danger';
                            else if (data === 'PendingVerification') badgeClass = 'bg-warning text-dark';
                            return '<span class="badge ' + badgeClass + '">' + data + '</span>';
                        }
                    },
                    {
                        data: 'createdAtUtc',
                        render: function (data) {
                            return new Date(data).toLocaleDateString('es');
                        }
                    }
                ],
                defaultOrder: [[4, 'desc']]
            });
        });
    </script>
}
