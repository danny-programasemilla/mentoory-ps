@model Mentoory.Tenant.Application.Queries.ListProjects.ProjectDto

@{
    ViewData["Title"] = "Detalle del Proyecto";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Detalle del Proyecto</h2>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>Volver
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Nombre</dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4">Descripción</dt>
                    <dd class="col-sm-8">@(Model.Description ?? "Sin descripción")</dd>

                    <dt class="col-sm-4">Etapa Actual</dt>
                    <dd class="col-sm-8">@Model.CurrentStageType</dd>

                    <dt class="col-sm-4">Estado de Etapa</dt>
                    <dd class="col-sm-8">@Model.CurrentStageState</dd>

                    <dt class="col-sm-4">Estado</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Fecha de Creación</dt>
                    <dd class="col-sm-8">@Model.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-4">Última Actualización</dt>
                    <dd class="col-sm-8">@Model.UpdatedAtUtc.ToString("dd/MM/yyyy HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
