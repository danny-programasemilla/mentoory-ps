@model Mentoory.Tenant.Application.Queries.ListProjects.ProjectDto

@{
    ViewData["Title"] = "Detalle del Proyecto";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Detalle del Proyecto</h3>
                <div class="card-actions">
                    <a asp-action="Index" class="btn btn-ghost-secondary">
                        <i class="ti ti-arrow-left me-1"></i>Volver
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div class="datagrid">
                    <div class="datagrid-item">
                        <div class="datagrid-title">Nombre</div>
                        <div class="datagrid-content">@Model.Name</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Descripción</div>
                        <div class="datagrid-content">@(Model.Description ?? "Sin descripción")</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Etapa Actual</div>
                        <div class="datagrid-content">@Model.CurrentStageType</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Estado de Etapa</div>
                        <div class="datagrid-content">@Model.CurrentStageState</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Estado</div>
                        <div class="datagrid-content">
                            @if (Model.IsActive)
                            {
                                <span class="status status-success">Activo</span>
                            }
                            else
                            {
                                <span class="status status-secondary">Inactivo</span>
                            }
                        </div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Fecha de Creación</div>
                        <div class="datagrid-content">@Model.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Última Actualización</div>
                        <div class="datagrid-content">@Model.UpdatedAtUtc.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
