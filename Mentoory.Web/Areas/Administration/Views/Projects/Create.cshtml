@model CreateProjectViewModel

@{
    ViewData["Title"] = "Nuevo Proyecto";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Nuevo Proyecto</h3>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="Nombre del proyecto" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"
                                  placeholder="Descripción del proyecto (opcional)"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="hr-text">Configuración</div>

                    <div class="mb-3 form-check">
                        <input asp-for="IsPublic" class="form-check-input" type="checkbox" />
                        <label asp-for="IsPublic" class="form-check-label"></label>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EnrollmentVariant" class="form-label"></label>
                        <select asp-for="EnrollmentVariant" class="form-select">
                            <option value="0">Flujo completo</option>
                            <option value="1">Directo</option>
                        </select>
                        <span asp-validation-for="EnrollmentVariant" class="text-danger"></span>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="btn-list justify-content-end">
                        <a asp-action="Index" class="btn btn-ghost-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-device-floppy me-1"></i>Crear Proyecto
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
