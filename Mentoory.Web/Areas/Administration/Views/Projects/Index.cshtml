@{
    ViewData["Title"] = "Proyectos";
}

@section PageActions {
    <div class="col-auto">
        <a asp-action="Create" class="btn btn-primary">
            <i class="ti ti-plus me-1"></i>Nuevo Proyecto
        </a>
    </div>
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@await Component.InvokeAsync("DataTable", new { tableId = "projectsTable", columns = new[] { "Nombre", "Descripción", "Etapa", "Estado", "Fecha de Creación", "Acciones" } })

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script src="~/js/datatable-helper.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            initDataTable('projectsTable', {
                apiUrl: '@Url.Action("Data", "Projects", new { area = "Administration" })',
                columns: [
                    { data: 'name' },
                    {
                        data: 'description',
                        render: function (data) {
                            return data || '<span class="text-muted">Sin descripción</span>';
                        }
                    },
                    { data: 'currentStageType' },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data
                                ? renderStatus('Activo', 'success')
                                : renderStatus('Inactivo', 'secondary');
                        }
                    },
                    {
                        data: 'createdAtUtc',
                        render: function (data) { return formatDate(data); }
                    },
                    {
                        data: 'externalId',
                        orderable: false,
                        render: function (data) {
                            var placeholder = '00000000-0000-0000-0000-000000000000';
                            var detailsUrl = '@Url.Action("Details", "Projects", new { area = "Administration", externalId = System.Guid.Empty })'.replace(placeholder, data);
                            return '<a href="' + detailsUrl + '" class="btn btn-sm btn-outline-primary" title="Ver detalles"><i class="ti ti-eye"></i></a>';
                        }
                    }
                ],
                filters: [{ column: 'isActive', type: 'select', options: FILTER_OPTIONS_ACTIVE_MASC }],
                defaultOrder: [[4, 'desc']]
            });
        });
    </script>
}
