@model Mentoory.Web.Areas.Participant.Models.DiagnosticLandingViewModel
@{
    ViewData["Title"] = "Diagnósticos";
}

<div class="mb-4">
    <h2>Mis Diagnósticos</h2>
    <p class="text-secondary">Estado de formularios diagnósticos asignados</p>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (TempData["WarningMessage"] is string warningMessage)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @warningMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (Model.Assignments.Count == 0)
{
    <div class="empty">
        <div class="empty-icon">
            <i class="ti ti-clipboard-check" style="font-size: 3rem;"></i>
        </div>
        <p class="empty-title">Sin diagnósticos asignados</p>
        <p class="empty-subtitle text-secondary">
            No hay formularios diagnósticos asignados para este proyecto.
        </p>
    </div>
}
else
{
    <div class="row row-cards">
        @foreach (var assignment in Model.Assignments)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            @if (assignment.IsCompleted)
                            {
                                <span class="badge bg-green me-2">Completado</span>
                            }
                            else
                            {
                                <span class="badge bg-yellow me-2">Pendiente</span>
                            }
                        </div>
                        <h3 class="card-title">@assignment.FormName</h3>
                        <p class="text-muted">@assignment.QuestionCount preguntas</p>

                        @if (assignment.CompletedAtUtc.HasValue)
                        {
                            <p class="text-muted mb-0">
                                <small><i class="ti ti-check me-1"></i>Completado: @assignment.CompletedAtUtc.Value.ToString("dd/MM/yyyy HH:mm")</small>
                            </p>
                        }
                    </div>
                    <div class="card-footer">
                        @if (!assignment.IsCompleted)
                        {
                            <a asp-action="Fill" asp-route-assignmentExternalId="@assignment.AssignmentExternalId"
                               class="btn btn-primary w-100">
                                <i class="ti ti-pencil me-1"></i>Completar
                            </a>
                        }
                        else
                        {
                            <span class="btn btn-ghost-success w-100 disabled">
                                <i class="ti ti-check me-1"></i>Completado
                            </span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
