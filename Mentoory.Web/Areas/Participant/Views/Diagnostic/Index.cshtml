@model Mentoory.Web.Areas.Participant.Models.DiagnosticFormViewModel
@{
    ViewData["Title"] = "Diagnóstico";
}

<div class="mb-4">
    <h2>Diagnóstico: @Model.FormName</h2>
    <p class="text-muted">Etapa de evaluación: <strong>@(Model.EvaluationStage == "Initial" ? "Inicial" : "Final")</strong></p>
</div>

<form asp-action="Submit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="FormExternalId" value="@Model.FormExternalId" />
    <input type="hidden" name="EvaluationStage" value="@(Model.EvaluationStage == "Initial" ? 0 : 1)" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    @if (Model.Questions.Count == 0)
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-1"></i>No hay preguntas disponibles en este formulario.
        </div>
    }

    @for (var i = 0; i < Model.Questions.Count; i++)
    {
        var question = Model.Questions[i];
        <div class="card shadow-sm mb-3">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <span>
                        <strong>@(i + 1).</strong> @question.QuestionText
                    </span>
                    @if (question.IsOptional)
                    {
                        <span class="badge bg-warning">Opcional</span>
                    }
                </div>
            </div>
            <div class="card-body">
                <input type="hidden" name="Responses[@i].QuestionId" value="@question.QuestionId" />

                @if (question.QuestionType == "Text")
                {
                    <textarea name="Responses[@i].TextValue" class="form-control" rows="3"
                              placeholder="Escriba su respuesta..."></textarea>
                }
                else if (question.QuestionType == "Numeric")
                {
                    <input type="number" name="Responses[@i].NumericValue" class="form-control"
                           step="0.01" placeholder="Ingrese un valor numérico" />
                }
                else if (question.QuestionType == "SingleSelect")
                {
                    @foreach (var option in question.AnswerOptions.OrderBy(a => a.SortOrder))
                    {
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio"
                                   name="Responses[@i].SelectedOptionIds[0]" value="@option.AnswerOptionId"
                                   id="option-@option.AnswerOptionId" />
                            <label class="form-check-label" for="option-@option.AnswerOptionId">
                                @option.OptionText
                            </label>
                        </div>
                    }
                }
                else if (question.QuestionType == "MultiSelect")
                {
                    var checkIndex = 0;
                    @foreach (var option in question.AnswerOptions.OrderBy(a => a.SortOrder))
                    {
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox"
                                   name="Responses[@i].SelectedOptionIds[@checkIndex]" value="@option.AnswerOptionId"
                                   id="option-@option.AnswerOptionId" />
                            <label class="form-check-label" for="option-@option.AnswerOptionId">
                                @option.OptionText
                            </label>
                        </div>
                        checkIndex++;
                    }
                }

                @if (question.FollowUpQuestions.Any())
                {
                    <hr />
                    <p class="text-muted mb-2"><small>Preguntas de seguimiento (informativas):</small></p>
                    <ul class="list-unstyled ms-3">
                        @foreach (var followUp in question.FollowUpQuestions)
                        {
                            <li class="text-muted"><i class="fas fa-info-circle me-1"></i>@followUp.QuestionText</li>
                        }
                    </ul>
                }
            </div>
        </div>
    }

    <div class="mt-4 mb-5">
        <button type="submit" class="btn btn-primary btn-lg">
            <i class="fas fa-paper-plane me-1"></i>Enviar Diagnóstico
        </button>
        <a href="/" class="btn btn-outline-secondary btn-lg ms-2">
            <i class="fas fa-times me-1"></i>Cancelar
        </a>
    </div>
</form>
