@{
    ViewData["Title"] = "Mi Diagnóstico";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Mi Diagnóstico</h2>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Formularios Disponibles</h3>
    </div>
    <div class="table-responsive">
        <table id="participantFormsTable" class="table table-vcenter card-table w-100">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Preguntas</th>
                    <th>Fecha de Creación</th>
                    <th>Acciones</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/datatable-helper.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            initDataTable('participantFormsTable', {
                apiUrl: '@Url.Action("Data", "Diagnostic", new { area = "Participant" })',
                columns: [
                    { data: 'name' },
                    { data: 'questionCount' },
                    {
                        data: 'createdAtUtc',
                        render: function (data) {
                            return new Date(data).toLocaleDateString('es');
                        }
                    },
                    {
                        data: 'externalId',
                        orderable: false,
                        render: function (data) {
                            var respondUrl = '@Url.Action("Index", "Diagnostic", new { area = "Participant" })' + '?formExternalId=' + data;
                            return '<a href="' + respondUrl + '" class="btn btn-sm btn-primary"><i class="ti ti-pencil me-1"></i>Responder</a>';
                        }
                    }
                ],
                defaultOrder: [[2, 'desc']]
            });
        });
    </script>
}
