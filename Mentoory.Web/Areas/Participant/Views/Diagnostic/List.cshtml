@{
    ViewData["Title"] = "Mi Diagnóstico";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Mi Diagnóstico</h2>
</div>

@await Component.InvokeAsync("DataTable", new { tableId = "participantFormsTable", columns = new[] { "Nombre", "Preguntas", "Fecha de Creación", "Acciones" }, title = "Formularios Disponibles" })

@section Scripts {
    <script src="~/js/datatable-helper.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            initDataTable('participantFormsTable', {
                apiUrl: '@Url.Action("Data", "Diagnostic", new { area = "Participant" })',
                columns: [
                    { data: 'name' },
                    { data: 'questionCount' },
                    {
                        data: 'createdAtUtc',
                        render: function (data) { return formatDate(data); }
                    },
                    {
                        data: 'externalId',
                        orderable: false,
                        render: function (data) {
                            var respondUrl = '@Url.Action("Index", "Diagnostic", new { area = "Participant" })' + '?formExternalId=' + data;
                            return '<a href="' + respondUrl + '" class="btn btn-sm btn-primary"><i class="ti ti-pencil me-1"></i>Responder</a>';
                        }
                    }
                ],
                defaultOrder: [[2, 'desc']]
            });
        });
    </script>
}
