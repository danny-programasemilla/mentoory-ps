@{
    ViewData["Title"] = "Enlace Enviado";
}

<div class="text-center">
    <h3 class="mb-2">Mentoory</h3>
    <h5 class="text-secondary mb-4">Enlace Enviado</h5>

    <div class="alert alert-info" role="alert">
        <p class="mb-0">Si existe una cuenta con ese correo electrónico, recibirá un enlace para restablecer su contraseña.</p>
    </div>

    <p class="text-secondary">
        Revise su bandeja de entrada y la carpeta de correo no deseado.
    </p>

    <div class="mt-4">
        <a asp-area="Access" asp-controller="Login" asp-action="Index" class="btn btn-primary">Volver a Iniciar Sesión</a>
    </div>
</div>
