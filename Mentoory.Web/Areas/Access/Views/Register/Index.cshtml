@model Mentoory.Web.Areas.Access.Models.RegisterViewModel
@{
    ViewData["Title"] = "Crear Cuenta";
}

<div class="text-center mb-4">
    <h2>Crear Cuenta</h2>
    <p class="text-secondary">Complete el formulario para registrarse en Mentoory</p>
</div>

<form asp-action="Index" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="email" autofocus />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="FirstName" class="form-label"></label>
            <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="LastName" class="form-label"></label>
            <input asp-for="LastName" class="form-control" autocomplete="family-name" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Country" class="form-label"></label>
            <select asp-for="Country" class="form-select" id="countrySelect">
                <option value="">Seleccione un país</option>
                @foreach (var country in Model.Countries)
                {
                    <option value="@country.Code"
                            data-mask="@country.IdentificationMask"
                            data-regex="@country.IdentificationRegex"
                            data-maxlength="@country.IdentificationMaxLength"
                            data-label="@country.IdentificationLabel">
                        @country.Name
                    </option>
                }
            </select>
            <span asp-validation-for="Country" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="NationalId" class="form-label" id="nationalIdLabel"></label>
            <input asp-for="NationalId" class="form-control" id="nationalIdInput" />
            <span asp-validation-for="NationalId" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <div class="d-grid mb-3">
        <button type="submit" class="btn btn-primary">Crear Cuenta</button>
    </div>

    <div class="text-center">
        <a asp-area="Access" asp-controller="Login" asp-action="Index">¿Ya tiene una cuenta? Iniciar sesión</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/registration.js"></script>
}
