@{
    ViewData["Title"] = "Verificar Correo Electrónico";
    var success = (bool)(ViewData["Success"] ?? false);
    var message = (string)(ViewData["Message"] ?? string.Empty);
}

<div class="text-center">
    <h3 class="mb-2">Mentoory</h3>
    <p class="text-secondary mb-4">Verificación de Correo Electrónico</p>

    @if (success)
    {
        <div class="alert alert-success" role="alert">
            <p class="mb-0">@message</p>
        </div>

        <div class="mt-4">
            <a asp-area="Access" asp-controller="Login" asp-action="Index" class="btn btn-primary">Iniciar Sesión</a>
        </div>
    }
    else
    {
        <div class="alert alert-danger" role="alert">
            <p class="mb-0">@message</p>
        </div>

        <div class="mt-4">
            <a asp-area="Access" asp-controller="Login" asp-action="Index" class="btn btn-outline-primary">Volver al Inicio</a>
        </div>
    }
</div>
