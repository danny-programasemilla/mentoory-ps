@{
    ViewData["Title"] = "Verificar Correo Electrónico";
    var success = (bool)(ViewData["Success"] ?? false);
    var message = (string)(ViewData["Message"] ?? string.Empty);
}

<div class="text-center">
    <div class="mb-4">
        @if (success)
        {
            <span class="avatar avatar-xl bg-success-lt">
                <i class="ti ti-mail-check" style="font-size: 2rem;"></i>
            </span>
        }
        else
        {
            <span class="avatar avatar-xl bg-danger-lt">
                <i class="ti ti-mail-off" style="font-size: 2rem;"></i>
            </span>
        }
    </div>
    <h3>Verificación de Correo Electrónico</h3>

    @if (success)
    {
        <p class="text-success">@message</p>
        <div class="mt-4">
            <a asp-area="Access" asp-controller="Login" asp-action="Index" class="btn btn-primary">
                Iniciar Sesión
            </a>
        </div>
    }
    else
    {
        <p class="text-danger">@message</p>
        <div class="mt-4">
            <a asp-area="Access" asp-controller="Login" asp-action="Index" class="btn btn-ghost-primary">
                Volver al Inicio
            </a>
        </div>
    }
</div>
