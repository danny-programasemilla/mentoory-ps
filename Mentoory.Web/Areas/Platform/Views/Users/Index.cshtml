@{
    ViewData["Title"] = "Usuarios de la Plataforma";
}

@await Component.InvokeAsync("DataTable", new { tableId = "usersTable", columns = new[] { "Correo Electrónico", "Nombre", "Apellido", "Estado", "Fecha de Registro" } })

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script src="~/js/datatable-helper.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            initDataTable('usersTable', {
                apiUrl: '@Url.Action("Data", "Users", new { area = "Platform" })',
                columns: [
                    { data: 'email' },
                    { data: 'firstName' },
                    { data: 'lastName' },
                    {
                        data: 'accountStatus',
                        render: function (data) { return renderAccountStatus(data); }
                    },
                    {
                        data: 'createdAtUtc',
                        render: function (data) { return formatDate(data); }
                    }
                ],
                defaultOrder: [[4, 'desc']]
            });
        });
    </script>
}
