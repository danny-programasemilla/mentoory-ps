@{
    ViewData["Title"] = "Usuarios de la Plataforma";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Usuarios de la Plataforma</h2>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Usuarios</h3>
    </div>
    <div class="table-responsive">
        <table id="usersTable" class="table table-vcenter card-table w-100">
            <thead>
                <tr>
                    <th>Correo Electrónico</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Estado</th>
                    <th>Fecha de Registro</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script src="~/js/datatable-helper.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            initDataTable('usersTable', {
                apiUrl: '@Url.Action("Data", "Users", new { area = "Platform" })',
                columns: [
                    { data: 'email' },
                    { data: 'firstName' },
                    { data: 'lastName' },
                    {
                        data: 'accountStatus',
                        render: function (data) {
                            var badgeClass = 'bg-secondary';
                            if (data === 'Active') badgeClass = 'bg-success';
                            else if (data === 'Locked') badgeClass = 'bg-danger';
                            else if (data === 'PendingVerification') badgeClass = 'bg-warning text-dark';
                            return '<span class="badge ' + badgeClass + '">' + data + '</span>';
                        }
                    },
                    {
                        data: 'createdAtUtc',
                        render: function (data) {
                            return new Date(data).toLocaleDateString('es');
                        }
                    }
                ],
                defaultOrder: [[4, 'desc']]
            });
        });
    </script>
}
