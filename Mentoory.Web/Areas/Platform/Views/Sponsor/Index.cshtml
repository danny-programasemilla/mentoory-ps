@{
    ViewData["Title"] = "Panel de Patrocinador";
}

<h2 class="mb-4">Panel de Patrocinador</h2>

<div class="row justify-content-center mt-5">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm text-center">
            <div class="card-body py-5">
                <div class="mb-4">
                    <div class="bg-info bg-opacity-10 rounded-circle d-inline-flex p-4">
                        <i class="fas fa-hard-hat fa-3x text-info"></i>
                    </div>
                </div>
                <h4 class="mb-3">Próximamente</h4>
                <p class="text-muted mb-0">
                    El panel de patrocinador se encuentra en desarrollo.
                    Pronto podrá consultar el estado de los proyectos que apoya.
                </p>
            </div>
        </div>
    </div>
</div>
