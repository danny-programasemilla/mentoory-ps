@{
    ViewData["Title"] = "Panel de Patrocinador";
}

<div class="row row-deck row-cards">
    <div class="col-sm-6 col-xl-4">
        <div class="card card-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="avatar bg-info-lt">
                            <i class="ti ti-helmet"></i>
                        </span>
                    </div>
                    <div class="col">
                        <div class="font-weight-medium">Próximamente</div>
                        <div class="text-secondary">El panel de patrocinador se encuentra en desarrollo</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
        <div class="card">
            <div class="card-body">
                <div class="empty">
                    <div class="empty-icon">
                        <i class="ti ti-helmet" style="font-size: 3rem;"></i>
                    </div>
                    <p class="empty-title">En desarrollo</p>
                    <p class="empty-subtitle text-secondary">
                        Pronto podrá consultar el estado de los proyectos que apoya.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
