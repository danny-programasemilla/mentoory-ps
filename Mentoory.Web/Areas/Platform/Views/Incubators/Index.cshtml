@{
    ViewData["Title"] = "Incubadoras";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Incubadoras</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="ti ti-plus me-1"></i>Nueva Incubadora
    </a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@await Component.InvokeAsync("DataTable", new { tableId = "incubatorsTable", columns = new[] { "Nombre", "Descripción", "Estado", "Fecha de Creación", "Acciones" }, title = "Incubadoras" })

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script src="~/js/datatable-helper.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            initDataTable('incubatorsTable', {
                apiUrl: '@Url.Action("Data", "Incubators", new { area = "Platform" })',
                columns: [
                    { data: 'name' },
                    {
                        data: 'description',
                        render: function (data) {
                            return data || '<span class="text-muted">Sin descripción</span>';
                        }
                    },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data
                                ? renderStatus('Activa', 'success')
                                : renderStatus('Inactiva', 'secondary');
                        }
                    },
                    {
                        data: 'createdAtUtc',
                        render: function (data) { return formatDate(data); }
                    },
                    {
                        data: 'externalId',
                        orderable: false,
                        render: function (data) {
                            var placeholder = '00000000-0000-0000-0000-000000000000';
                            var detailsUrl = '@Url.Action("Details", "Incubators", new { area = "Platform", externalId = System.Guid.Empty })'.replace(placeholder, data);
                            var editUrl = '@Url.Action("Edit", "Incubators", new { area = "Platform", externalId = System.Guid.Empty })'.replace(placeholder, data);
                            return '<a href="' + detailsUrl + '" class="btn btn-sm btn-outline-primary me-1" title="Ver detalles"><i class="ti ti-eye"></i></a>' +
                                   '<a href="' + editUrl + '" class="btn btn-sm btn-outline-secondary" title="Editar"><i class="ti ti-edit"></i></a>';
                        }
                    }
                ],
                defaultOrder: [[3, 'desc']]
            });
        });
    </script>
}
