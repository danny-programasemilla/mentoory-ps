@model EditIncubatorViewModel

@{
    ViewData["Title"] = "Editar Incubadora";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <form asp-action="Edit" asp-route-externalId="@Model.ExternalId" method="post">
            @Html.AntiForgeryToken()
            <div class="card">
                <div class="card-body">
                    <input type="hidden" asp-for="ExternalId" />

                    <div class="hr-text">Datos de la Incubadora</div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Estado</label>
                        <label class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <span class="form-check-label">Activa</span>
                        </label>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="btn-list justify-content-end">
                        <a asp-action="Index" class="btn btn-ghost-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-device-floppy me-1"></i>Guardar Cambios
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
