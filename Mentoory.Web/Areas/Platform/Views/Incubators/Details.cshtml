@model Mentoory.Tenant.Application.Queries.ListIncubators.IncubatorDto

@{
    ViewData["Title"] = "Detalle de Incubadora";
}

@section PageActions {
    <div class="col-auto">
        <a asp-action="Edit" asp-route-externalId="@Model.ExternalId" class="btn btn-outline-primary me-1">
            <i class="ti ti-edit me-1"></i>Editar
        </a>
        <a asp-action="Index" class="btn btn-ghost-secondary">
            <i class="ti ti-arrow-left me-1"></i>Volver
        </a>
    </div>
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @successMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }

        <div class="card">
            <div class="card-header">
                <h3 class="card-title">@Model.Name</h3>
            </div>
            <div class="card-body">
                <div class="datagrid">
                    <div class="datagrid-item">
                        <div class="datagrid-title">Nombre</div>
                        <div class="datagrid-content">@Model.Name</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Descripción</div>
                        <div class="datagrid-content">@(Model.Description ?? "Sin descripción")</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Estado</div>
                        <div class="datagrid-content">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Activa</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactiva</span>
                            }
                        </div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Fecha de Creación</div>
                        <div class="datagrid-content">@Model.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Última Actualización</div>
                        <div class="datagrid-content">@Model.UpdatedAtUtc.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
