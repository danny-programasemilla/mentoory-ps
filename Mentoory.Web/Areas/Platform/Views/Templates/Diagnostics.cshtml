@{
    ViewData["Title"] = "Plantillas de Diagnóstico";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Plantillas de Diagnóstico</h2>
</div>

@await Component.InvokeAsync("DataTable", new { tableId = "templatesTable", columns = new[] { "Nombre", "Descripción", "Nivel de Suscripción", "Versión", "Estado", "Fecha de Creación" }, title = "Plantillas de Diagnóstico" })

@section Scripts {
    <script src="~/js/datatable-helper.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            initDataTable('templatesTable', {
                apiUrl: '@Url.Action("DiagnosticsData", "Templates", new { area = "Platform" })',
                columns: [
                    { data: 'name' },
                    {
                        data: 'description',
                        render: function (data) {
                            return data || '<span class="text-muted">Sin descripción</span>';
                        }
                    },
                    {
                        data: 'subscriptionTier',
                        render: function (data) {
                            return data || '<span class="text-muted">Todas</span>';
                        }
                    },
                    { data: 'version' },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data
                                ? renderStatus('Activa', 'success')
                                : renderStatus('Inactiva', 'secondary');
                        }
                    },
                    {
                        data: 'createdAtUtc',
                        render: function (data) { return formatDate(data); }
                    }
                ],
                defaultOrder: [[5, 'desc']]
            });
        });
    </script>
}
