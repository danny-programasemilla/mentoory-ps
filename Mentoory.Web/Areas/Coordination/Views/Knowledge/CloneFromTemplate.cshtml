@using Mentoory.Knowledge.Application.Queries.ListKnowledgeStructureTemplates
@using Mentoory.Web.Areas.Coordination.Models.Knowledge
@model CloneStructureViewModel
@{
    ViewData["Title"] = "Clonar desde plantilla";
    var templates = ViewBag.Templates as IReadOnlyList<KnowledgeStructureTemplateListItemDto>
        ?? Array.Empty<KnowledgeStructureTemplateListItemDto>();
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <form asp-action="CloneFromTemplate" method="post">
            @Html.AntiForgeryToken()
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Clonar estructura desde plantilla</h3>
                </div>
                <div class="card-body">
                    <p class="text-secondary mb-3">
                        Seleccione una plantilla activa para clonar su estructura en el proyecto actual.
                        La versión capturada en el momento del clon se usará para detectar desincronizaciones futuras.
                    </p>

                    <div asp-validation-summary="All" class="alert alert-danger"></div>

                    @if (!templates.Any())
                    {
                        <div class="alert alert-warning">
                            <i class="ti ti-alert-triangle me-1"></i>
                            No hay plantillas activas disponibles para clonar. Solicite a un administrador global que cree o desarchive una plantilla.
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label asp-for="SourceTemplateExternalId" class="form-label required"></label>
                            <select asp-for="SourceTemplateExternalId" class="form-select" autofocus>
                                <option value="">— Seleccione una plantilla —</option>
                                @foreach (var template in templates)
                                {
                                    <option value="@template.ExternalId">
                                        @template.Name (v@(template.Version)) — @template.ModuleCount mód. / @template.TopicCount tem.
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="SourceTemplateExternalId" class="text-danger"></span>
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <div class="btn-list justify-content-end">
                        <a asp-action="Projects" class="btn btn-ghost-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary" @(templates.Any() ? string.Empty : "disabled")>
                            <i class="ti ti-copy me-1"></i>Clonar
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
