@using Mentoory.Knowledge.Application.Queries.ListProjectKnowledgeStructures
@using Mentoory.Knowledge.Domain.Enums
@model IReadOnlyList<ProjectKnowledgeStructureListItemDto>
@{
    ViewData["Title"] = "Estructuras de Conocimiento del Proyecto";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Estructuras de Conocimiento del Proyecto</h2>
    <a asp-action="CloneFromTemplateGet" class="btn btn-primary">
        <i class="ti ti-copy me-1"></i>Clonar desde plantilla
    </a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (TempData["WarningMessage"] is string warningMessage)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @warningMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Listado de Estructuras</h3>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="empty">
                <div class="empty-icon">
                    <i class="ti ti-books-off" style="font-size: 3rem;"></i>
                </div>
                <p class="empty-title">Sin estructuras</p>
                <p class="empty-subtitle text-secondary">
                    Aún no hay estructuras de conocimiento para este proyecto. Clone una plantilla para comenzar.
                </p>
                <div class="empty-action">
                    <a asp-action="CloneFromTemplateGet" class="btn btn-primary">
                        <i class="ti ti-copy me-1"></i>Clonar desde plantilla
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-vcenter table-hover">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Plantilla de origen</th>
                            <th class="text-center">Versión</th>
                            <th class="text-center">Módulos</th>
                            <th class="text-center">Temas</th>
                            <th>Modo de sincronización</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var structure in Model)
                        {
                            <tr data-structure-id="@structure.ExternalId">
                                <td>
                                    <div class="fw-bold">@structure.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(structure.Description))
                                    {
                                        <div class="text-secondary small">@structure.Description</div>
                                    }
                                </td>
                                <td>
                                    @if (structure.SourceTemplateExternalId.HasValue)
                                    {
                                        <span class="text-secondary small">
                                            <i class="ti ti-template me-1"></i>@structure.SourceTemplateExternalId.Value.ToString("D").Substring(0, 8)…
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary small">—</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (structure.SourceTemplateVersion.HasValue)
                                    {
                                        <span class="badge bg-info">v@(structure.SourceTemplateVersion.Value)</span>
                                        @if (structure.HasTemplateVersionDrift)
                                        {
                                            <span class="badge bg-warning ms-1" title="La plantilla de origen tiene una versión más reciente.">Desactualizada</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-secondary">—</span>
                                    }
                                </td>
                                <td class="text-center">@structure.ModuleCount</td>
                                <td class="text-center">@structure.TopicCount</td>
                                <td>
                                    @switch (structure.SyncMode)
                                    {
                                        case SyncMode.PartialSync:
                                            <span class="badge bg-azure">Sincronización parcial</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">Desconectada</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-list justify-content-end">
                                        <a asp-action="ProjectStructureDetail" asp-route-externalId="@structure.ExternalId"
                                           class="btn btn-sm btn-outline-primary" title="Ver detalles">
                                            <i class="ti ti-eye me-1"></i>Ver detalles
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
