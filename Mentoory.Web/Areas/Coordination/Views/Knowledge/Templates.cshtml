@using Mentoory.Knowledge.Application.Queries.ListKnowledgeStructureTemplates
@model IReadOnlyList<KnowledgeStructureTemplateListItemDto>
@{
    ViewData["Title"] = "Plantillas de Conocimiento";
    var includeArchived = ViewBag.IncludeArchived as bool? ?? false;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Plantillas de Conocimiento</h2>
    <a asp-action="CreateTemplate" class="btn btn-primary">
        <i class="ti ti-plus me-1"></i>Crear plantilla
    </a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (TempData["WarningMessage"] is string warningMessage)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @warningMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="card"
     id="knowledge-templates-list"
     data-url-archive-template="@Url.Action("ArchiveTemplate", "Knowledge", new { area = "Coordination", externalId = System.Guid.Empty })"
     data-url-unarchive-template="@Url.Action("UnarchiveTemplate", "Knowledge", new { area = "Coordination", externalId = System.Guid.Empty })"
     data-url-delete-template="@Url.Action("DeleteTemplate", "Knowledge", new { area = "Coordination", externalId = System.Guid.Empty })">
    <div class="card-header">
        <h3 class="card-title">Listado de Plantillas</h3>
        <div class="card-actions">
            <form method="get" asp-action="Templates" class="d-flex align-items-center">
                <label class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" name="includeArchived" value="true"
                           @(includeArchived ? "checked" : "") onchange="this.form.submit()" />
                    <span class="form-check-label">Mostrar archivados</span>
                </label>
            </form>
        </div>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="empty">
                <div class="empty-icon">
                    <i class="ti ti-template" style="font-size: 3rem;"></i>
                </div>
                <p class="empty-title">Sin plantillas</p>
                <p class="empty-subtitle text-secondary">
                    No hay plantillas de conocimiento creadas.
                </p>
                <div class="empty-action">
                    <a asp-action="CreateTemplate" class="btn btn-primary">
                        <i class="ti ti-plus me-1"></i>Crear la primera plantilla
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-vcenter table-hover">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th class="text-center">Versión</th>
                            <th class="text-center">Módulos</th>
                            <th class="text-center">Temas</th>
                            <th class="text-center">Asignaturas</th>
                            <th class="text-center">Recursos</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var template in Model)
                        {
                            <tr data-template-id="@template.ExternalId">
                                <td>
                                    <div class="fw-bold">@template.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(template.Description))
                                    {
                                        <div class="text-secondary small">@template.Description</div>
                                    }
                                </td>
                                <td class="text-center"><span class="badge bg-info">v@(template.Version)</span></td>
                                <td class="text-center">@template.ModuleCount</td>
                                <td class="text-center">@template.TopicCount</td>
                                <td class="text-center">@template.SubjectCount</td>
                                <td class="text-center">@template.ResourceCount</td>
                                <td>
                                    @if (template.IsArchived)
                                    {
                                        <span class="badge bg-secondary">Archivado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-list justify-content-end">
                                        <a asp-action="TemplateDetail" asp-route-externalId="@template.ExternalId"
                                           class="btn btn-sm btn-outline-primary" title="Ver detalles">
                                            <i class="ti ti-eye me-1"></i>Ver
                                        </a>
                                        @if (template.IsArchived)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-success"
                                                    data-action="unarchive-template"
                                                    data-template-id="@template.ExternalId">
                                                <i class="ti ti-archive-off me-1"></i>Desarchivar
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-warning"
                                                    data-action="archive-template"
                                                    data-template-id="@template.ExternalId">
                                                <i class="ti ti-archive me-1"></i>Archivar
                                            </button>
                                        }
                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                data-action="delete-template"
                                                data-template-id="@template.ExternalId"
                                                data-template-name="@template.Name">
                                            <i class="ti ti-trash me-1"></i>Eliminar
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<div id="toastContainer" class="toast-container position-fixed bottom-0 end-0 p-3"></div>

@section Scripts {
    <script src="~/js/site.js"></script>
    <script src="~/js/knowledge/templates-list.js"></script>
}
