@using Mentoory.Knowledge.Application.Queries.GetProjectKnowledgeStructure
@using Mentoory.Knowledge.Domain.Enums
@model ProjectKnowledgeStructureDetailDto
@{
    ViewData["Title"] = Model?.Name ?? "Estructura de Conocimiento";
}

@if (Model is null)
{
    <div class="empty">
        <div class="empty-icon">
            <i class="ti ti-file-off" style="font-size: 3rem;"></i>
        </div>
        <p class="empty-title">Estructura no encontrada</p>
        <div class="empty-action">
            <a asp-action="Projects" class="btn btn-primary">
                <i class="ti ti-arrow-left me-1"></i>Volver al listado
            </a>
        </div>
    </div>
    return;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">@Model.Name</h2>
        <div class="text-secondary small">
            @if (Model.SourceTemplateVersion.HasValue)
            {
                <span class="badge bg-info">Plantilla v@(Model.SourceTemplateVersion.Value)</span>
            }
            else
            {
                <span class="badge bg-secondary">Sin plantilla de origen</span>
            }
            @switch (Model.SyncMode)
            {
                case SyncMode.PartialSync:
                    <span class="badge bg-azure ms-1">Sincronización parcial</span>
                    break;
                default:
                    <span class="badge bg-secondary ms-1">Desconectada</span>
                    break;
            }
            <span class="ms-2">Creada el @Model.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
        </div>
    </div>
    <a asp-action="Projects" class="btn btn-ghost-secondary">
        <i class="ti ti-arrow-left me-1"></i>Volver al listado
    </a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="card mb-4"
     data-structure-id="@Model.ExternalId"
     data-module-count="@Model.Modules.Count"
     data-guid-placeholder="00000000-0000-0000-0000-000000000000"
     data-url-update-structure="@Url.Action("UpdateProjectStructure", "Knowledge", new { area = "Coordination", structureExternalId = Model.ExternalId })"
     data-url-set-sync-mode="@Url.Action("SetProjectStructureSyncMode", "Knowledge", new { area = "Coordination", structureExternalId = Model.ExternalId })"
     data-url-sync-from-template="@Url.Action("SyncFromTemplate", "Knowledge", new { area = "Coordination", structureExternalId = Model.ExternalId })"
     data-url-add-module="@Url.Action("AddProjectModule", "Knowledge", new { area = "Coordination", structureExternalId = Model.ExternalId })"
     data-url-update-module="@Url.Action("UpdateProjectModule", "Knowledge", new { area = "Coordination", structureExternalId = Model.ExternalId, moduleExternalId = System.Guid.Empty })"
     data-url-delete-module="@Url.Action("DeleteProjectModule", "Knowledge", new { area = "Coordination", structureExternalId = Model.ExternalId, moduleExternalId = System.Guid.Empty })"
     data-url-add-topic="@Url.Action("AddProjectTopic", "Knowledge", new { area = "Coordination", structureExternalId = Model.ExternalId })"
     data-url-update-topic="@Url.Action("UpdateProjectTopic", "Knowledge", new { area = "Coordination", structureExternalId = Model.ExternalId, topicExternalId = System.Guid.Empty })"
     data-url-delete-topic="@Url.Action("DeleteProjectTopic", "Knowledge", new { area = "Coordination", structureExternalId = Model.ExternalId, topicExternalId = System.Guid.Empty })"
     data-url-update-topic-ranges="@Url.Action("UpdateProjectTopicPriorityRanges", "Knowledge", new { area = "Coordination", structureExternalId = Model.ExternalId, topicExternalId = System.Guid.Empty })"
     data-url-add-subject="@Url.Action("AddProjectSubject", "Knowledge", new { area = "Coordination", structureExternalId = Model.ExternalId })"
     data-url-update-subject="@Url.Action("UpdateProjectSubject", "Knowledge", new { area = "Coordination", structureExternalId = Model.ExternalId, subjectExternalId = System.Guid.Empty })"
     data-url-delete-subject="@Url.Action("DeleteProjectSubject", "Knowledge", new { area = "Coordination", structureExternalId = Model.ExternalId, subjectExternalId = System.Guid.Empty })"
     data-url-add-resource="@Url.Action("AddProjectResource", "Knowledge", new { area = "Coordination", structureExternalId = Model.ExternalId })"
     data-url-update-resource="@Url.Action("UpdateProjectResource", "Knowledge", new { area = "Coordination", structureExternalId = Model.ExternalId, resourceExternalId = System.Guid.Empty })"
     data-url-delete-resource="@Url.Action("DeleteProjectResource", "Knowledge", new { area = "Coordination", structureExternalId = Model.ExternalId, resourceExternalId = System.Guid.Empty })">
    <div class="card-header">
        <h3 class="card-title">Información de la Estructura</h3>
        <div class="card-actions">
            <button type="button" class="btn btn-sm btn-outline-primary"
                    data-action="edit-structure"
                    data-structure-id="@Model.ExternalId"
                    data-name="@Model.Name"
                    data-description="@Model.Description">
                <i class="ti ti-pencil me-1"></i>Editar
            </button>
        </div>
    </div>
    <div class="card-body">
        <div class="datagrid">
            <div class="datagrid-item">
                <div class="datagrid-title">Nombre</div>
                <div class="datagrid-content" data-field="structure-name">@Model.Name</div>
            </div>
            <div class="datagrid-item">
                <div class="datagrid-title">Descripción</div>
                <div class="datagrid-content" data-field="structure-description">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)
                </div>
            </div>
            <div class="datagrid-item">
                <div class="datagrid-title">Plantilla de origen</div>
                <div class="datagrid-content">
                    @if (Model.SourceTemplateExternalId.HasValue)
                    {
                        <code>@Model.SourceTemplateExternalId.Value</code>
                    }
                    else
                    {
                        <span class="text-secondary">—</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <h3 class="card-title">Modo de Sincronización</h3>
    </div>
    <div class="card-body">
        <p class="text-secondary small mb-3">
            <strong>Desconectada:</strong> no se arrastran cambios desde la plantilla de origen.
            <br />
            <strong>Sincronización parcial:</strong> permite traer elementos nuevos de la plantilla manteniendo las personalizaciones locales.
        </p>
        <div class="btn-group" role="group" aria-label="Modo de sincronización">
            <input type="radio" class="btn-check" name="syncMode" id="sync-disconnected"
                   value="0" @(Model.SyncMode == SyncMode.Disconnected ? "checked" : "") />
            <label class="btn btn-outline-secondary" for="sync-disconnected">
                <i class="ti ti-plug-off me-1"></i>Desconectada
            </label>

            <input type="radio" class="btn-check" name="syncMode" id="sync-partial"
                   value="1" @(Model.SyncMode == SyncMode.PartialSync ? "checked" : "") />
            <label class="btn btn-outline-secondary" for="sync-partial">
                <i class="ti ti-refresh me-1"></i>Sincronización parcial
            </label>
        </div>
        <div class="mt-3">
            <button type="button" class="btn btn-primary btn-sm"
                    data-action="save-sync-mode" data-structure-id="@Model.ExternalId">
                <i class="ti ti-device-floppy me-1"></i>Guardar modo
            </button>
            <button type="button" class="btn btn-azure btn-sm ms-2"
                    data-action="sync-from-template" data-structure-id="@Model.ExternalId"
                    disabled="@(Model.SyncMode == SyncMode.Disconnected)"
                    title="@(Model.SyncMode == SyncMode.Disconnected ? "Habilite Sincronización parcial y guarde el modo para poder sincronizar." : "Traer elementos nuevos desde la plantilla.")">
                <i class="ti ti-cloud-download me-1"></i>Sincronizar desde plantilla
            </button>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Estructura (Módulos / Temas / Asignaturas / Recursos)</h3>
        <div class="card-actions">
            <button type="button" class="btn btn-primary btn-sm"
                    data-action="add-module" data-structure-id="@Model.ExternalId">
                <i class="ti ti-plus me-1"></i>Agregar módulo
            </button>
        </div>
    </div>
    <div class="card-body">
        @if (!Model.Modules.Any())
        {
            <div class="empty">
                <div class="empty-icon">
                    <i class="ti ti-stack" style="font-size: 3rem;"></i>
                </div>
                <p class="empty-title">Sin módulos</p>
                <p class="empty-subtitle text-secondary">
                    Esta estructura aún no tiene módulos. Agregue el primero para comenzar.
                </p>
            </div>
        }
        else
        {
            <div class="accordion" id="project-modules-tree" data-structure-id="@Model.ExternalId">
                @foreach (var module in Model.Modules)
                {
                    @await Html.PartialAsync("_ProjectStructureTree", module)
                }
            </div>
        }
    </div>
</div>

<!-- Generic form modal used for all create/edit dialogs -->
<div class="modal modal-blur fade" id="knowledgeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="knowledgeModalTitle">Formulario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="knowledgeModalBody">
                <!-- Populated dynamically by project-structure-editor.js -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="knowledgeModalSubmit">
                    <i class="ti ti-check me-1"></i>Guardar
                </button>
            </div>
        </div>
    </div>
</div>

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<div id="toastContainer" class="toast-container position-fixed bottom-0 end-0 p-3"></div>

@section Scripts {
    <script src="~/js/site.js"></script>
    <script src="~/js/knowledge/project-structure-editor.js"></script>
}
