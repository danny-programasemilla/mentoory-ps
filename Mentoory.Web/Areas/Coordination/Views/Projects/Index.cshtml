@{
    ViewData["Title"] = "Proyectos";
}

@if (TempData[TempDataKeys.SuccessMessage] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData[TempDataKeys.ErrorMessage] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@await Component.InvokeAsync("DataTable", new { tableId = "coordinationProjectsTable", columns = new[] { "Nombre", "Descripción", "Etapa Actual", "Estado", "Acciones" } })

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script src="~/js/datatable-helper.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var stageLabels = {
                'Registration': 'Registro',
                'Forms': 'Formularios',
                'Analysis': 'Análisis',
                'LearningAssignment': 'Asignación de Aprendizaje',
                'Mentoring': 'Mentoría',
                'FinalEvaluation': 'Evaluación Final',
                'Closure': 'Cierre'
            };

            initDataTable('coordinationProjectsTable', {
                apiUrl: '@Url.Action("Data", "Projects", new { area = "Coordination" })',
                columns: [
                    { data: 'name' },
                    {
                        data: 'description',
                        render: function (data) {
                            return data || '<span class="text-muted">Sin descripción</span>';
                        }
                    },
                    {
                        data: 'currentStageType',
                        render: function (data) {
                            return stageLabels[data] || data;
                        }
                    },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data
                                ? renderStatus('Activo', 'success')
                                : renderStatus('Inactivo', 'secondary');
                        }
                    },
                    {
                        data: 'externalId',
                        orderable: false,
                        render: function (data) {
                            var placeholder = '00000000-0000-0000-0000-000000000000';
                            var lifecycleUrl = '@Url.Action("Lifecycle", "Projects", new { area = "Coordination", externalId = System.Guid.Empty })'.replace(placeholder, data);
                            return '<a href="' + lifecycleUrl + '" class="btn btn-sm btn-outline-primary" title="Ver ciclo de vida"><i class="ti ti-timeline"></i></a>';
                        }
                    }
                ],
                filters: [{ column: 'isActive', type: 'select', options: FILTER_OPTIONS_ACTIVE_MASC }],
                defaultOrder: [[0, 'asc']]
            });
        });
    </script>
}
