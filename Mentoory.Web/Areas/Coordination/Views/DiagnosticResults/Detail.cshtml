@model Mentoory.Diagnostic.Application.Queries.GetDiagnosticResponse.DiagnosticResponseDto
@{
    ViewData["Title"] = "Detalle de Diagnóstico";
}

<div class="mb-4">
    <h2>Detalle de Diagnóstico</h2>
    <p class="text-secondary">Respuestas individuales del diagnóstico</p>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <strong>Estado:</strong>
                @if (Model.IsCompleted)
                {
                    <span class="badge bg-green">Completado</span>
                }
                else
                {
                    <span class="badge bg-yellow">En progreso</span>
                }
            </div>
            @if (Model.CompletedAtUtc.HasValue)
            {
                <div class="col-md-6">
                    <strong>Fecha de completado:</strong> @Model.CompletedAtUtc.Value.ToString("dd/MM/yyyy HH:mm")
                </div>
            }
        </div>
    </div>
</div>

@foreach (var qr in Model.Responses)
{
    <div class="card mb-2">
        <div class="card-body py-3">
            <div class="d-flex justify-content-between">
                <div>
                    <strong>Pregunta @qr.QuestionId</strong>
                    @if (!string.IsNullOrEmpty(qr.TextValue))
                    {
                        <p class="mb-0 mt-1">@qr.TextValue</p>
                    }
                    @if (qr.NumericValue.HasValue)
                    {
                        <p class="mb-0 mt-1">Valor: <strong>@qr.NumericValue</strong></p>
                    }
                    @if (qr.SelectedOptionIds.Any())
                    {
                        <p class="mb-0 mt-1 text-muted">Opciones: @string.Join(", ", qr.SelectedOptionIds)</p>
                    }
                </div>
                @if (qr.Corrections.Any())
                {
                    <span class="badge bg-orange">Corregida (@qr.Corrections.Count)</span>
                }
            </div>
        </div>
    </div>
}

<div class="mt-3">
    <a href="javascript:history.back()" class="btn btn-secondary">
        <i class="ti ti-arrow-left me-1"></i>Volver
    </a>
</div>
