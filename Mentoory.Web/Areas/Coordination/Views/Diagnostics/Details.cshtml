@using Mentoory.Diagnostic.Application.Queries.GetProjectForm
@model ProjectFormDto
@{
    ViewData["Title"] = "Detalle del Formulario";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@Model?.Name</h2>
    <a asp-action="Index" class="btn btn-ghost-secondary">
        <i class="ti ti-arrow-left me-1"></i>Volver
    </a>
</div>

@if (Model is null)
{
    <div class="empty">
        <div class="empty-icon">
            <i class="ti ti-file-off" style="font-size: 3rem;"></i>
        </div>
        <p class="empty-title">Formulario no encontrado</p>
        <p class="empty-subtitle text-secondary">
            El formulario solicitado no existe o no tiene acceso.
        </p>
        <div class="empty-action">
            <a asp-action="Index" class="btn btn-primary">
                <i class="ti ti-arrow-left me-1"></i>Volver al listado
            </a>
        </div>
    </div>
    return;
}

<div class="card mb-4">
    <div class="card-header">
        <h3 class="card-title">Información del Formulario</h3>
    </div>
    <div class="card-body">
        <div class="datagrid">
            <div class="datagrid-item">
                <div class="datagrid-title">Nombre</div>
                <div class="datagrid-content">@Model.Name</div>
            </div>
            <div class="datagrid-item">
                <div class="datagrid-title">Modo de Sincronización</div>
                <div class="datagrid-content">@Model.SyncMode</div>
            </div>
            <div class="datagrid-item">
                <div class="datagrid-title">Fecha de Creación</div>
                <div class="datagrid-content">@Model.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
            </div>
            <div class="datagrid-item">
                <div class="datagrid-title">Preguntas</div>
                <div class="datagrid-content">@Model.Questions.Count</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Preguntas</h3>
    </div>
    <div class="card-body">
        @if (!Model.Questions.Any())
        {
            <div class="empty">
                <div class="empty-icon">
                    <i class="ti ti-list" style="font-size: 3rem;"></i>
                </div>
                <p class="empty-title">Sin preguntas</p>
                <p class="empty-subtitle text-secondary">
                    No hay preguntas en este formulario.
                </p>
            </div>
        }
        else
        {
            <div class="accordion" id="questionsAccordion">
                @foreach (var (question, index) in Model.Questions.Select((q, i) => (q, i)))
                {
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="heading-@index">
                            <button class="accordion-button collapsed" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#collapse-@index">
                                <span class="me-2 badge bg-secondary">@(index + 1)</span>
                                @question.QuestionText
                                <span class="ms-2 badge bg-info">@question.QuestionType</span>
                                @if (question.IsOptional)
                                {
                                    <span class="ms-1 badge bg-warning">Opcional</span>
                                }
                            </button>
                        </h2>
                        <div id="collapse-@index" class="accordion-collapse collapse"
                             data-bs-parent="#questionsAccordion">
                            <div class="accordion-body">
                                <div class="datagrid mb-3">
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Tipo</div>
                                        <div class="datagrid-content">@question.QuestionType</div>
                                    </div>
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Aplicabilidad</div>
                                        <div class="datagrid-content">@question.StageApplicability</div>
                                    </div>
                                    @if (question.BlockGroup is not null)
                                    {
                                        <div class="datagrid-item">
                                            <div class="datagrid-title">Grupo</div>
                                            <div class="datagrid-content">@question.BlockGroup</div>
                                        </div>
                                    }
                                </div>

                                @if (question.AnswerOptions.Any())
                                {
                                    <div class="hr-text">Opciones de Respuesta</div>
                                    <div class="table-responsive">
                                        <table class="table table-vcenter table-striped table-hover table-sm">
                                            <thead>
                                                <tr>
                                                    <th>Texto</th>
                                                    <th>Puntaje</th>
                                                    <th>FODA</th>
                                                    <th>ODSR</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var option in question.AnswerOptions)
                                                {
                                                    <tr>
                                                        <td>@option.OptionText</td>
                                                        <td>@option.Score</td>
                                                        <td>@option.SwotClassification</td>
                                                        <td>@option.OdsrOrientation</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }

                                @if (question.FollowUpQuestions.Any())
                                {
                                    <div class="hr-text">Preguntas de Seguimiento</div>
                                    <ul>
                                        @foreach (var followUp in question.FollowUpQuestions)
                                        {
                                            <li>@followUp.QuestionText</li>
                                        }
                                    </ul>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
