@model Mentoory.Web.Areas.Coordination.Models.StageConfigViewModel
@{
    ViewData["Title"] = "Configuración de Etapa";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Formularios Asignados</h2>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#assignFormModal">
        <i class="ti ti-plus me-1"></i>Asignar Formulario
    </button>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (Model.Assignments.Count == 0)
{
    <div class="alert alert-info">
        <i class="ti ti-info-circle me-1"></i>
        No hay formularios asignados a esta etapa. Use el botón "Asignar Formulario" para agregar uno.
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>Formulario</th>
                        <th>Preguntas</th>
                        <th>Fecha de Asignación</th>
                        <th class="w-1">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var assignment in Model.Assignments)
                    {
                        <tr>
                            <td>@assignment.FormName</td>
                            <td>@assignment.QuestionCount preguntas</td>
                            <td>@assignment.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-action="QuestionSelection" asp-route-assignmentExternalId="@assignment.ExternalId"
                                       class="btn btn-sm btn-outline-primary" title="Seleccionar preguntas">
                                        <i class="ti ti-list-check me-1"></i>Preguntas
                                    </a>
                                    <form asp-action="RemoveAssignment" asp-route-assignmentExternalId="@assignment.ExternalId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="stageExternalId" value="@Model.ProjectStageExternalId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('¿Está seguro de eliminar esta asignación?')"
                                                title="Eliminar asignación">
                                            <i class="ti ti-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-controller="ProjectPipeline" asp-action="Index" class="btn btn-secondary">
        <i class="ti ti-arrow-left me-1"></i>Volver a Etapas
    </a>
</div>

<!-- Assign Form Modal -->
<div class="modal fade" id="assignFormModal" tabindex="-1" aria-labelledby="assignFormModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AssignForm" asp-route-stageExternalId="@Model.ProjectStageExternalId" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="assignFormModalLabel">Asignar Formulario</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="formExternalId" class="form-label">Formulario</label>
                        <select name="formExternalId" id="formExternalId" class="form-select" required>
                            <option value="">Seleccionar formulario...</option>
                            @if (ViewBag.AvailableForms != null)
                            {
                                foreach (var form in (List<Mentoory.Web.Areas.Coordination.Models.FormOptionViewModel>)ViewBag.AvailableForms)
                                {
                                    <option value="@form.ExternalId">@form.Name</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Asignar</button>
                </div>
            </form>
        </div>
    </div>
</div>
