@{
    ViewData["Title"] = "Formularios Diagnósticos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Formularios Diagnósticos</h2>
    <a asp-action="Clone" class="btn btn-primary">
        <i class="ti ti-copy me-1"></i>Clonar Plantilla
    </a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (ViewBag.HasProjectContext == false)
{
    <div class="alert alert-warning" role="alert">
        <i class="ti ti-alert-triangle me-1"></i>
        No tiene un proyecto activo seleccionado. Para ver y gestionar formularios diagnósticos,
        <a href="/Context/Select" class="alert-link">seleccione un contexto con un proyecto activo</a>.
    </div>
}

@await Component.InvokeAsync("DataTable", new { tableId = "diagnosticFormsTable", columns = new[] { "Nombre", "Modo Sincronización", "Preguntas", "Fecha de Creación", "Acciones" }, title = "Listado de Formularios" })

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script src="~/js/datatable-helper.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            initDataTable('diagnosticFormsTable', {
                apiUrl: '@Url.Action("Data", "Diagnostics", new { area = "Coordination" })',
                columns: [
                    { data: 'name' },
                    {
                        data: 'syncMode',
                        render: function (data) {
                            return data === 0
                                ? renderStatus('Desconectado', 'secondary')
                                : renderStatus('Sincronización parcial', 'info');
                        }
                    },
                    { data: 'questionCount' },
                    {
                        data: 'createdAtUtc',
                        render: function (data) { return formatDate(data); }
                    },
                    {
                        data: 'externalId',
                        orderable: false,
                        render: function (data) {
                            var placeholder = '00000000-0000-0000-0000-000000000000';
                            var detailsUrl = '@Url.Action("Details", "Diagnostics", new { area = "Coordination", externalId = System.Guid.Empty })'.replace(placeholder, data);
                            return '<a href="' + detailsUrl + '" class="btn btn-sm btn-outline-primary" title="Ver detalles"><i class="ti ti-eye me-1"></i>Ver</a>';
                        }
                    }
                ],
                defaultOrder: [[3, 'desc']]
            });
        });
    </script>
}
