@model Mentoory.Web.Areas.Coordination.Models.CloneDiagnosticFormViewModel
@{
    ViewData["Title"] = "Clonar Plantilla de Diagnóstico";
    var templates = ViewBag.Templates as List<Mentoory.Web.Areas.Coordination.Models.FormTemplateOptionViewModel> ?? new();
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <form asp-action="Clone" method="post">
            @Html.AntiForgeryToken()
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Clonar Plantilla de Diagnóstico</h3>
                </div>
                <div class="card-body">
                    <p class="text-secondary mb-3">Seleccione una plantilla global para clonar en este proyecto.</p>

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    @if (!templates.Any())
                    {
                        <div class="empty">
                            <div class="empty-icon">
                                <i class="ti ti-template" style="font-size: 3rem;"></i>
                            </div>
                            <p class="empty-title">Sin plantillas disponibles</p>
                            <p class="empty-subtitle text-secondary">
                                No hay plantillas disponibles para clonar.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="hr-text">Plantillas Disponibles</div>

                        <div class="row">
                            @foreach (var template in templates)
                            {
                                <div class="col-md-6 col-lg-4 mb-3">
                                    <div class="card h-100 template-card" data-template-id="@template.ExternalId">
                                        <div class="card-body">
                                            <h5 class="card-title">@template.Name</h5>
                                            <p class="card-text text-secondary">
                                                @(template.Description ?? "Sin descripción")
                                            </p>
                                            <span class="badge bg-info">v@(template.Version)</span>
                                        </div>
                                        <div class="card-footer">
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio"
                                                       name="SourceTemplateExternalId" value="@template.ExternalId"
                                                       id="template-@template.ExternalId" />
                                                <label class="form-check-label" for="template-@template.ExternalId">
                                                    Seleccionar
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <span asp-validation-for="SourceTemplateExternalId" class="text-danger"></span>
                    }
                </div>
                <div class="card-footer">
                    <div class="btn-list justify-content-end">
                        <a asp-action="Index" class="btn btn-ghost-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary" @(!templates.Any() ? "disabled" : "")>
                            <i class="ti ti-copy me-1"></i>Clonar Plantilla
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
