@using Mentoory.Diagnostic.Application.Queries.GetDiagnosticResponse
@model DiagnosticResponseDto
@{
    ViewData["Title"] = "Corrección de Respuestas";
}

<div class="mb-4">
    <h2>Corrección de Respuestas</h2>
    <p class="text-secondary">Estado: @(Model?.IsCompleted == true ? "Completado" : "En progreso")</p>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (Model is null)
{
    <div class="empty">
        <div class="empty-icon">
            <i class="ti ti-file-off" style="font-size: 3rem;"></i>
        </div>
        <p class="empty-title">Respuesta diagnóstica no encontrada</p>
        <p class="empty-subtitle text-secondary">
            No se encontró la respuesta diagnóstica solicitada.
        </p>
    </div>
    return;
}

@foreach (var response in Model.Responses)
{
    <div class="card mb-3">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center w-100">
                <h3 class="card-title">Pregunta #@response.QuestionId</h3>
                <button class="btn btn-sm btn-outline-warning" type="button"
                        data-bs-toggle="modal" data-bs-target="#correctModal-@response.Id">
                    <i class="ti ti-edit me-1"></i>Corregir
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="datagrid mb-3">
                @if (response.TextValue is not null)
                {
                    <div class="datagrid-item">
                        <div class="datagrid-title">Respuesta de texto</div>
                        <div class="datagrid-content">@response.TextValue</div>
                    </div>
                }
                @if (response.NumericValue.HasValue)
                {
                    <div class="datagrid-item">
                        <div class="datagrid-title">Valor numérico</div>
                        <div class="datagrid-content">@response.NumericValue</div>
                    </div>
                }
            </div>

            @if (response.Corrections.Any())
            {
                <div class="hr-text">Historial de Correcciones</div>
                <div class="table-responsive">
                    <table class="table table-vcenter table-striped table-hover table-sm">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Valor Anterior</th>
                                <th>Razón</th>
                                <th>Corregido por</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var correction in response.Corrections.OrderByDescending(c => c.CorrectedAtUtc))
                            {
                                <tr>
                                    <td>@correction.CorrectedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @(correction.PreviousTextValue ?? correction.PreviousNumericValue?.ToString() ?? correction.PreviousSelectedOptionIds ?? "—")
                                    </td>
                                    <td>@(correction.Reason ?? "—")</td>
                                    <td>Usuario #@correction.CorrectedByUserId</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Correction Modal -->
    <div class="modal fade" id="correctModal-@response.Id" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="Correct" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="diagnosticExternalId" value="@Model.ExternalId" />
                    <input type="hidden" name="questionResponseId" value="@response.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title">Corregir Respuesta</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Nuevo valor de texto</label>
                            <textarea name="newTextValue" class="form-control" rows="2">@response.TextValue</textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Nuevo valor numérico</label>
                            <input type="number" name="newNumericValue" class="form-control"
                                   step="0.01" value="@response.NumericValue" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Razón de la corrección</label>
                            <textarea name="reason" class="form-control" rows="2"
                                      placeholder="Indique la razón de la corrección..." required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <div class="btn-list ms-auto">
                            <button type="button" class="btn btn-ghost-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-warning">
                                <i class="ti ti-check me-1"></i>Aplicar Corrección
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
