@{
    ViewData["Title"] = "Enlace Enviado";
    Layout = "_Layout";
}

<div class="login-container">
    <div class="card login-card shadow">
        <div class="card-body text-center">
            <h3 class="card-title mb-4">Mentoory</h3>
            <h5 class="text-muted mb-4">Enlace Enviado</h5>

            <div class="alert alert-info" role="alert">
                <p class="mb-0">Si existe una cuenta con ese correo electrónico, recibirá un enlace para restablecer su contraseña.</p>
            </div>

            <p class="text-muted">
                Revise su bandeja de entrada y la carpeta de correo no deseado.
            </p>

            <div class="mt-4">
                <a asp-area="Identity" asp-controller="Login" asp-action="Index" class="btn btn-primary">Volver a Iniciar Sesión</a>
            </div>
        </div>
    </div>
</div>
