@{
    ViewBag.ContextSelectorMode = "modal";
}
<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row align-items-center">
            @if (User.Identity?.IsAuthenticated == true)
            {
                var activeRole = User.GetActiveRole();
                var activeIncubatorName = User.FindFirst("ActiveIncubatorName")?.Value;
                var activeProjectName = User.FindFirst("ActiveProjectName")?.Value;

                if (!string.IsNullOrEmpty(activeRole))
                {
                    <div class="col-auto d-flex align-items-center" id="context-display" data-testid="current-context">
                        <span class="badge bg-primary me-2">@activeRole</span>
                        @if (!string.IsNullOrEmpty(activeIncubatorName))
                        {
                            <span class="text-secondary small me-2">
                                <i class="ti ti-building me-1"></i>@activeIncubatorName
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(activeProjectName))
                        {
                            <span class="text-secondary small me-2">
                                <i class="ti ti-sitemap me-1"></i>@activeProjectName
                            </span>
                        }
                        <button type="button"
                                class="btn btn-outline-primary btn-sm ms-2"
                                data-bs-toggle="modal"
                                data-bs-target="#contextSwitcherModal"
                                title="Cambiar contexto">
                            <i class="ti ti-switch-horizontal me-1"></i>Cambiar contexto
                        </button>
                    </div>
                }
            }
            <div class="col-auto ms-auto d-flex align-items-center">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="text-secondary me-3">@User.Identity.Name</span>
                    <form asp-area="Access" asp-controller="Logout" asp-action="Index" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Cerrar sesión</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="modal fade" id="contextSwitcherModal" tabindex="-1" aria-labelledby="contextSwitcherModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="contextSwitcherModalLabel">Cambiar Contexto de Trabajo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    @await Html.PartialAsync("_ContextSelector")
                </div>
            </div>
        </div>
    </div>
}
