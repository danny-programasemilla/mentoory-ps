<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom px-4">
    <div class="container-fluid">
        @if (User.Identity?.IsAuthenticated == true)
        {
            var activeRole = User.GetActiveRole();
            var activeIncubatorName = User.FindFirst("ActiveIncubatorName")?.Value;
            var activeProjectName = User.FindFirst("ActiveProjectName")?.Value;

            if (!string.IsNullOrEmpty(activeRole))
            {
                <div class="d-flex align-items-center me-auto" id="context-display" data-testid="current-context">
                    <span class="badge bg-primary me-2">@activeRole</span>
                    @if (!string.IsNullOrEmpty(activeIncubatorName))
                    {
                        <span class="text-muted small me-2">
                            <i class="fas fa-building me-1"></i>@activeIncubatorName
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(activeProjectName))
                    {
                        <span class="text-muted small me-2">
                            <i class="fas fa-project-diagram me-1"></i>@activeProjectName
                        </span>
                    }
                    <a asp-controller="Context" asp-action="Select" asp-area=""
                       class="btn btn-outline-primary btn-sm ms-2"
                       title="Cambiar contexto">
                        <i class="fas fa-exchange-alt me-1"></i>Cambiar contexto
                    </a>
                </div>
            }
        }
        <div class="d-flex align-items-center ms-auto">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="text-muted me-3">@User.Identity.Name</span>
                <form asp-area="Access" asp-controller="Logout" asp-action="Index" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary btn-sm">Cerrar sesión</button>
                </form>
            }
        </div>
    </div>
</nav>
