@{
    var hasTitle = !string.IsNullOrEmpty((string?)ViewBag.Title);
}
<div class="card">
    @if (hasTitle)
    {
        <div class="card-header">
            <h3 class="card-title">@ViewBag.Title</h3>
        </div>
    }
    <div class="table-responsive">
        <table id="@ViewBag.TableId" class="table table-vcenter table-striped table-hover card-table w-100">
            <thead>
                <tr>
                    @foreach (var col in (string[])ViewBag.Columns)
                    {
                        <th>@col</th>
                    }
                </tr>
            </thead>
        </table>
    </div>
</div>
