<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mentoory</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/datatables/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/mentoory.css" />
    <link rel="stylesheet" href="~/Mentoory.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="d-flex">
        @if (User.Identity?.IsAuthenticated == true)
        {
            await Html.RenderPartialAsync("_Navigation");
        }
        <main class="flex-grow-1">
            @if (User.Identity?.IsAuthenticated == true)
            {
                await Html.RenderPartialAsync("_TopBar");
                <div class="container-fluid py-3 px-4">
                    @await Html.PartialAsync("_Breadcrumbs")
                    @RenderBody()
                </div>
            }
            else
            {
                @RenderBody()
            }
            @await Html.PartialAsync("_Footer")
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/datatables/dataTables.min.js"></script>
    <script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
