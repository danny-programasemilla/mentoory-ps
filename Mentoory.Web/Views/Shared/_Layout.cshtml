<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mentoory</title>
    <link rel="stylesheet" href="~/lib/tabler/css/tabler.min.css" />
    <link rel="stylesheet" href="~/lib/tabler-icons-webfont/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/lib/datatables/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/mentoory.css" />
    <link rel="stylesheet" href="~/Mentoory.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(User.Identity?.IsAuthenticated == true ? "layout-fluid" : "")">
    @if (User.Identity?.IsAuthenticated == true)
    {
        var area = ViewContext.RouteData.Values["area"]?.ToString();
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        var action = ViewContext.RouteData.Values["action"]?.ToString();
        var pageTitle = ViewData["Title"]?.ToString() ?? controller ?? "";

        <div class="page">
            @await Html.PartialAsync("_Navigation")
            <div class="page-wrapper">
                <div class="page-header d-print-none">
                    <div class="container-xl">
                        <div class="row align-items-center">
                            @* Left zone: breadcrumb as page-pretitle + page-title *@
                            <div class="col">
                                <div class="page-pretitle">
                                    <ol class="breadcrumb" aria-label="breadcrumbs">
                                        <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                                        @if (!string.IsNullOrEmpty(area))
                                        {
                                            <li class="breadcrumb-item">@area</li>
                                        }
                                        @if (!string.IsNullOrEmpty(controller) && controller != "Home")
                                        {
                                            <li class="breadcrumb-item">@controller</li>
                                        }
                                        @if (!string.IsNullOrEmpty(action) && action != "Index")
                                        {
                                            <li class="breadcrumb-item active" aria-current="page">@action</li>
                                        }
                                    </ol>
                                </div>
                                <h2 class="page-title">@pageTitle</h2>
                            </div>
                            @* Per-page action buttons opt in via @@section PageActions *@
                            @await RenderSectionAsync("PageActions", required: false)
                            @* Right zone: context indicators + user menu *@
                            @await Html.PartialAsync("_TopBar")
                        </div>
                    </div>
                </div>
                <div class="page-body">
                    <div class="container-xl">
                        @RenderBody()
                    </div>
                </div>
                @await Html.PartialAsync("_Footer")
            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/tabler/js/tabler.min.js"></script>
    <script>window.bootstrap = window.tabler;</script>
    <script src="~/lib/datatables/dataTables.min.js"></script>
    <script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/site.js"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/js/context-selector.js"></script>
        <script src="~/js/context-switcher.js"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
    @await Component.InvokeAsync("Toast")
</body>
</html>
