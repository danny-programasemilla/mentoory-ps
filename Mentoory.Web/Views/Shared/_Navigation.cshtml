@inject Mentoory.Web.Infrastructure.Menu.IMenuService MenuService

@{
    var menuItems = MenuService.GetVisibleMenuItems();
    var platformGroups = new[] { "Plataforma" };
    var contextGroups = new[] { "Administración", "Coordinación", "Participante" };

    var hasPlatformSection = menuItems
        .OfType<Mentoory.Web.Infrastructure.Menu.MenuGroup>()
        .Any(g => platformGroups.Contains(g.Title));
    var hasContextSection = menuItems
        .OfType<Mentoory.Web.Infrastructure.Menu.MenuGroup>()
        .Any(g => contextGroups.Contains(g.Title));
    var platformSectionRendered = false;
    var contextSectionRendered = false;

    var currentArea = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    var activeRole = User.GetActiveRole();
    var activeIncubatorName = User.FindFirst("ActiveIncubatorName")?.Value;
    var activeProjectName = User.FindFirst("ActiveProjectName")?.Value;
    var canSwitchContext = User.CanSwitchContext();

    // Avatar + context lines, shared by the interactive and static card variants.
    // Incubator and project each get their own truncating line so the full name is
    // visible without hovering — only an individually over-long name is clipped.
    void RenderContextCardBody()
    {
        <span class="avatar avatar-sm me-2"><i class="ti ti-building-community"></i></span>
        <div class="text-truncate">
            <div class="text-truncate" title="@activeRole">@activeRole</div>
            @if (!string.IsNullOrEmpty(activeIncubatorName))
            {
                <div class="small text-secondary text-truncate" title="@activeIncubatorName">@activeIncubatorName</div>
            }
            @if (!string.IsNullOrEmpty(activeProjectName))
            {
                <div class="small text-secondary text-truncate" title="@activeProjectName">@activeProjectName</div>
            }
        </div>
    }
}

<aside id="sidebar" class="navbar navbar-vertical navbar-expand-sm" data-bs-theme="dark">
    <div class="container-fluid">
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-menu"
                aria-controls="sidebar-menu" aria-expanded="false" aria-label="Navegación">
            <span class="navbar-toggler-icon"></span>
        </button>
        <h1 class="navbar-brand navbar-brand-autodark">
            <a href="/">
                <img src="~/img/logo-white.svg" class="navbar-brand-image" height="32" alt="Mentoory" />
            </a>
        </h1>
        <div class="collapse navbar-collapse" id="sidebar-menu">
            <ul class="navbar-nav pt-lg-3">
                @foreach (var item in menuItems)
                {
                    if (item is Mentoory.Web.Infrastructure.Menu.MenuGroup group)
                    {
                        @if (hasPlatformSection && platformGroups.Contains(group.Title) && !platformSectionRendered)
                        {
                            platformSectionRendered = true;
                            <li class="nav-item pt-3">
                                <span class="nav-link nav-link-header">
                                    Gestión de Plataforma
                                </span>
                            </li>
                        }
                        @if (hasContextSection && contextGroups.Contains(group.Title) && !contextSectionRendered)
                        {
                            contextSectionRendered = true;
                            @if (platformSectionRendered)
                            {
                                <li><hr class="dropdown-divider" /></li>
                            }
                            <li class="nav-item">
                                <span class="nav-link nav-link-header">
                                    Administración del Contexto
                                </span>
                            </li>
                        }

                        var groupExpanded = group.Items.Any(child =>
                        {
                            var uri = new Uri(child.Url ?? "/", UriKind.RelativeOrAbsolute);
                            var path = uri.IsAbsoluteUri ? uri.AbsolutePath : child.Url ?? "";
                            var segments = path.Trim('/').Split('/');
                            if (segments.Length >= 2)
                            {
                                return string.Equals(segments[0], currentArea, StringComparison.OrdinalIgnoreCase)
                                    && string.Equals(segments[1], currentController, StringComparison.OrdinalIgnoreCase);
                            }
                            return false;
                        });

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(groupExpanded ? "show" : "")"
                               href="#navbar-@group.Title.ToLowerInvariant().Replace("ó","o").Replace("á","a")"
                               data-bs-toggle="dropdown" data-bs-auto-close="false"
                               role="button" aria-expanded="@(groupExpanded ? "true" : "false")">
                                <span class="nav-link-icon"><i class="@group.Icon"></i></span>
                                <span class="nav-link-title">@group.Title</span>
                            </a>
                            <div class="dropdown-menu @(groupExpanded ? "show" : "")">
                                @foreach (var child in group.Items)
                                {
                                    var childUri = new Uri(child.Url ?? "/", UriKind.RelativeOrAbsolute);
                                    var childPath = childUri.IsAbsoluteUri ? childUri.AbsolutePath : child.Url ?? "";
                                    var childSegments = childPath.Trim('/').Split('/');
                                    var isActive = childSegments.Length >= 2
                                        && string.Equals(childSegments[0], currentArea, StringComparison.OrdinalIgnoreCase)
                                        && string.Equals(childSegments[1], currentController, StringComparison.OrdinalIgnoreCase);

                                    <a class="dropdown-item @(isActive ? "active" : "") d-flex align-items-center" href="@child.Url">
                                        @child.Title
                                        @if (child.BadgeCount.HasValue)
                                        {
                                            <span class="badge bg-primary ms-auto">@child.BadgeCount</span>
                                        }
                                    </a>
                                }
                            </div>
                        </li>
                    }
                    else
                    {
                        var itemPath = item.Url ?? "/";
                        var isHomeActive = itemPath == "/" && string.IsNullOrEmpty(currentArea) && (currentController == "Home" || currentController == "");

                        <li class="nav-item">
                            <a class="nav-link @(isHomeActive ? "active" : "")" href="@item.Url">
                                <span class="nav-link-icon"><i class="@item.Icon"></i></span>
                                <span class="nav-link-title">@item.Title</span>
                            </a>
                        </li>
                    }
                }
            </ul>

            @* Active-context card pinned to the sidebar bottom (relocated from the header). *@
            @if (!string.IsNullOrEmpty(activeRole))
            {
                <div class="mt-auto sidebar-context">
                    @if (canSwitchContext)
                    {
                        <a href="#" class="sidebar-context-card d-flex align-items-center text-reset text-decoration-none"
                           data-bs-toggle="modal" data-bs-target="#contextSwitcherModal"
                           data-testid="current-context" role="button"
                           aria-label="Cambiar contexto de trabajo">
                            @{ RenderContextCardBody(); }
                            <i class="ti ti-selector ms-auto"></i>
                        </a>
                    }
                    else
                    {
                        <div class="sidebar-context-card d-flex align-items-center" data-testid="current-context">
                            @{ RenderContextCardBody(); }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</aside>
