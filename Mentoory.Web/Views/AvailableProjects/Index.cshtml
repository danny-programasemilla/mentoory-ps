@model List<Mentoory.Tenant.Application.Projects.Queries.ListPublicProjects.PublicProjectDto>

@{
    ViewData["Title"] = "Proyectos Disponibles";
}

<div class="text-secondary mb-4">
    Explore los proyectos abiertos y solicite su inscripción.
</div>

@if (TempData["SuccessMessage"] is string successMsg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (TempData["ErrorMessage"] is string errorMsg)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (Model.Count == 0)
{
    <div class="card">
        <div class="card-body">
            <div class="empty">
                <div class="empty-icon">
                    <i class="ti ti-folder" style="font-size: 3rem;"></i>
                </div>
                <p class="empty-title">No hay proyectos disponibles</p>
                <p class="empty-subtitle text-secondary">
                    Actualmente no hay proyectos abiertos para inscripción. Por favor, vuelva a intentarlo más tarde.
                </p>
            </div>
        </div>
    </div>
}
else
{
    <div class="row row-deck row-cards">
        @foreach (var project in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card">
                    <div class="card-body d-flex flex-column">
                        <h3 class="card-title">@project.Name</h3>
                        <p class="text-secondary small mb-2">
                            <i class="ti ti-building me-1"></i>@project.IncubatorName
                        </p>
                        @if (!string.IsNullOrWhiteSpace(project.Description))
                        {
                            <p class="card-text flex-grow-1">@project.Description</p>
                        }
                        else
                        {
                            <p class="card-text text-secondary flex-grow-1">
                                <em>Sin descripción disponible.</em>
                            </p>
                        }
                        <div class="mt-auto pt-3">
                            <form asp-action="Enroll" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="projectExternalId" value="@project.ExternalId" />
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="ti ti-user-plus me-1"></i>Solicitar inscripción
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
