@model List<Mentoory.Tenant.Application.Projects.Queries.ListPublicProjects.PublicProjectDto>

@{
    ViewData["Title"] = "Proyectos Disponibles";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <h2 class="mb-4 text-center">Proyectos Disponibles</h2>
            <p class="text-muted text-center mb-4">
                Explore los proyectos abiertos y solicite su inscripción.
            </p>

            @if (TempData["SuccessMessage"] is string successMsg)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMsg
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] is string errorMsg)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMsg
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }

            @if (Model.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="ti ti-folder text-muted mb-3 d-block" style="font-size: 3rem;"></i>
                    <h5 class="text-muted">No hay proyectos disponibles</h5>
                    <p class="text-muted">
                        Actualmente no hay proyectos abiertos para inscripción. Por favor, vuelva a intentarlo más tarde.
                    </p>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var project in Model)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">@project.Name</h5>
                                    <p class="text-muted small mb-2">
                                        <i class="ti ti-building me-1"></i>@project.IncubatorName
                                    </p>
                                    @if (!string.IsNullOrWhiteSpace(project.Description))
                                    {
                                        <p class="card-text flex-grow-1">@project.Description</p>
                                    }
                                    else
                                    {
                                        <p class="card-text text-muted flex-grow-1">
                                            <em>Sin descripción disponible.</em>
                                        </p>
                                    }
                                    <div class="mt-auto pt-3">
                                        <form asp-action="Enroll" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="projectExternalId" value="@project.ExternalId" />
                                            <button type="submit" class="btn btn-primary w-100">
                                                <i class="ti ti-user-plus me-1"></i>Solicitar inscripción
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
